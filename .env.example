# Copy to .env and edit. docker compose reads .env from this directory automatically.
# Every value here has a working local default in docker-compose.yml, so .env is only
# needed to change ports or to replace the development secrets.

# --- Secrets: replace all three before deploying anywhere reachable ---
SA_PASSWORD=fbQ6ll9PQplNs2n
JWT_SECRET=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
SERVICE_API_KEY=local-dev-worker-key

# --- Published ports ---
APP_PORT=8080
API_PORT=8083
WORKER_PORT=3000
DB_PORT=3314

# The API address the *browser* uses for the diagram editor iframe. Locally this is the
# API's published port; on a server it is the public host, e.g. https://api.example.com.
# Must stay in step with API_PORT.
APP_PUBLIC_API_URL=http://localhost:8083

# Production or Development.
ASPNETCORE_ENVIRONMENT=Production
