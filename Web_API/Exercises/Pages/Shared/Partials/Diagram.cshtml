@*
    Diagram editor shell.

    Laid out as a full-height app (toolbar + canvas + shape tray) instead of a
    Bootstrap grid, so it fills whatever box embeds it — including a phone-sized
    iframe. All sizing lives in newdiagram.css / newdiagram.js; nothing here is
    hard-coded in pixels.

    NOTE: @section blocks are not rendered from a partial, so this file must not
    declare any — the scripts it needs are loaded by _LayoutBlank.cshtml and the
    page that includes it (DiagramEvaluation.cshtml).
*@

<div class="dg-app">

    <div class="dg-toolbar" role="toolbar" aria-label="Diagram tools">

        <div class="dg-group">
            <button type="button" id="MoveTool_Tool" class="dg-tool toolbarClick tools tools_select active"
                    title="Select and move">
                <i class="fas fa-mouse-pointer" aria-hidden="true"></i>
                <span class="dg-label">Select</span>
            </button>

            <button type="button" id="straight" class="dg-tool connectors tools tools_select"
                    title="Draw a straight arrow">
                <svg class="dg-ico" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M4 20 L16.5 7.5" />
                    <path d="M20 4 L17.5 11.4 L12.6 6.5 Z" fill="currentColor" stroke="none" />
                </svg>
                <span class="dg-label">Arrow</span>
            </button>

            <button type="button" id="cubic" class="dg-tool connectors tools tools_select"
                    title="Draw a curved arrow">
                <svg class="dg-ico" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M4 20 C 4 10, 9 4, 17 4" />
                    <path d="M21 4 L16.5 6.6 L16.5 1.4 Z" fill="currentColor" stroke="none" />
                </svg>
                <span class="dg-label">Curve</span>
            </button>

            <button type="button" id="Pan_Tool" class="dg-tool toolbarClick tools tools_select"
                    title="Pan the canvas">
                <i class="fas fa-hand-paper" aria-hidden="true"></i>
                <span class="dg-label">Pan</span>
            </button>
        </div>

        <span class="dg-sep" aria-hidden="true"></span>

        <div class="dg-group">
            <button type="button" id="Undo_Tool" class="dg-tool toolbarClick tools" title="Undo">
                <i class="fas fa-undo" aria-hidden="true"></i>
            </button>
            <button type="button" id="Redo_Tool" class="dg-tool toolbarClick tools" title="Redo">
                <i class="fas fa-redo" aria-hidden="true"></i>
            </button>
            <button type="button" id="ZoomOut_Tool" class="dg-tool toolbarClick tools" title="Zoom out">
                <i class="fas fa-search-minus" aria-hidden="true"></i>
            </button>
            <button type="button" id="ZoomIn_Tool" class="dg-tool toolbarClick tools" title="Zoom in">
                <i class="fas fa-search-plus" aria-hidden="true"></i>
            </button>
            <button type="button" id="FitToPage_Tool" class="dg-tool toolbarClick tools" title="Fit to screen">
                <i class="fas fa-expand-arrows-alt" aria-hidden="true"></i>
            </button>
        </div>

        <span class="dg-sep" aria-hidden="true"></span>

        <div class="dg-group">
            <button type="button" id="DeleteSelection_Tool" class="dg-tool dg-tool--danger toolbarClick tools"
                    title="Delete what is selected">
                <i class="far fa-trash-alt" aria-hidden="true"></i>
                <span class="dg-label">Delete</span>
            </button>
            <button type="button" id="Delete_Tool" class="dg-tool dg-tool--danger toolbarClick tools"
                    title="Clear the whole canvas">
                <i class="fas fa-eraser" aria-hidden="true"></i>
                <span class="dg-label">Clear</span>
            </button>
        </div>

        <span class="dg-spacer" aria-hidden="true"></span>

        <div class="dg-group">
            <button type="button" id="Upload_Tool" class="dg-tool toolbarClick tools" title="Open a saved diagram">
                <i class="far fa-folder-open" aria-hidden="true"></i>
                <span class="dg-label">Open</span>
            </button>
            <button type="button" id="Download_Tool" class="dg-tool toolbarClick tools" title="Save to a file">
                <i class="fas fa-file-download" aria-hidden="true"></i>
                <span class="dg-label">Save</span>
            </button>
        </div>

    </div>

    <div class="dg-workspace">

        <div class="dg-canvas" id="diagram-canvas">
            <ejs-diagram created="diagramCreated" id="diagram" width="100%" height="100%"
                         drop="drop" collectionChange="collectionChange">
                <e-diagram-rulersettings showRulers="false" dynamicGrid="true"></e-diagram-rulersettings>
            </ejs-diagram>
        </div>

        <div class="dg-palette" id="palette-space">
            <div class="dg-palette-body">
                <ejs-symbolpalette id="symbolpalette" allowDrag="true" enableAnimation="false"
                                   getNodeDefaults="@ViewBag.getNodeDefaults" symbolHeight="72" symbolWidth="72"
                                   getSymbolInfo="@ViewBag.getSymbolInfo" palettes="@ViewBag.palettes">
                </ejs-symbolpalette>
            </div>

            <p class="dg-hint">
                Drag a shape onto the canvas — or just tap it. Then pick
                <strong>Arrow</strong> and drag from one shape to another to connect them.
            </p>

            @* Kept in the DOM (visually hidden) because the Open button clicks its
               file input programmatically — display:none would break that. *@
            <div class="dg-uploader">
                <ejs-uploader id="fileupload" success="onUploadSuccess">
                    <e-uploader-asyncsettings saveUrl="https://aspnetmvc.syncfusion.com/services/api/uploadbox/Save" removeUrl="https://aspnetmvc.syncfusion.com/services/api/uploadbox/Remove">
                    </e-uploader-asyncsettings>
                </ejs-uploader>
            </div>
        </div>

    </div>

</div>
