@{
    ViewData["Title"] = "Evaluate Exercise";
    Layout = "_LayoutBlank";
}

<div style="display: none">
    <partial name="Partials/Code"/>
</div>

<partial name="Partials/Diagram"/>

@section scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/ace/1.32.0/ace.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/ace/1.32.0/mode-javascript.js"></script>
    @* Versioned like the stylesheets in _LayoutBlank: this file is the editor's half of
       the bridge to the host page, so a browser still holding the copy it cached before a
       deploy does not fail visibly — it just quietly stops answering the new messages. *@
    <script src="~/js/newdiagram.js" asp-append-version="true"></script>
}