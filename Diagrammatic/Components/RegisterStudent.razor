@page "/register-student"
@using Diagrammatic2.Components.Shared.Requests
@using Diagrammatic2.Components.Shared.Responses
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager
@inject IToastService toastService
@attribute [AllowAnonymous]

<PageTitle>Create student account · Diagrammatic</PageTitle>

<div class="ds-auth-shell">
    <div class="ds-auth-card">
        <div class="ds-auth-brand">
            <span class="ds-auth-mark">D</span>
            <span>Diagrammatic</span>
        </div>

        <h1 class="ds-auth-title">Join as a student</h1>
        <p class="ds-auth-subtitle">Create an account to take exams and track your scores.</p>

        <EditForm Model="registrationModel" OnValidSubmit="RegisterUser">
            <DataAnnotationsValidator />

            <div class="form-floating mb-3">
                <InputText id="email"
                           @bind-Value="registrationModel.email"
                           class="form-control"
                           autocomplete="username"
                           placeholder="name@example.com"
                           inputmode="email" />
                <label for="email">Email address</label>
                <ValidationMessage For="@(() => registrationModel.email)" class="validation-message" />
            </div>

            <div class="form-floating mb-4">
                <InputText id="password"
                           type="password"
                           @bind-Value="registrationModel.password"
                           class="form-control"
                           autocomplete="new-password"
                           placeholder="password" />
                <label for="password">Password</label>
                <ValidationMessage For="@(() => registrationModel.password)" class="validation-message" />
            </div>

            <div class="text-center mb-4">
                <span class="badge bg-secondary">
                    <span class="bi bi-mortarboard me-1"></span> Student account
                </span>
            </div>

            <button type="submit" class="w-100 btn btn-lg btn-primary">Create account</button>

            @if (!string.IsNullOrEmpty(responseMessage))
            {
                <div class="alert alert-warning mt-4">@responseMessage</div>
            }
        </EditForm>

        <p class="ds-auth-footer">
            Already have an account? <a href="login">Sign in</a>
        </p>
    </div>
</div>

@code {
    private UserRegistrationRequest registrationModel = new UserRegistrationRequest();
    private string? responseMessage;

    protected override void OnInitialized()
    {
        registrationModel.role = "Student";
    }

    private async Task RegisterUser()
    {
        try
        {
            var httpClient = HttpClientFactory.CreateClient("DiagrammaticClient");
            registrationModel.role = "Student";

            var response = await httpClient.PostAsJsonAsync("/identity/register", registrationModel);

            if (response.IsSuccessStatusCode)
            {
                toastService.ShowSuccess("Registration successful! Please log in.");
                NavigationManager.NavigateTo("/login");
            }
            else
            {
                var authFailedResponse = await response.Content.ReadFromJsonAsync<AuthFailedResponse>();

                if (authFailedResponse?.Errors != null && authFailedResponse.Errors.Any())
                {
                    responseMessage = string.Join(", ", authFailedResponse.Errors);
                }
                else
                {
                    responseMessage = "Registration failed. Please check your details.";
                }

                toastService.ShowError(responseMessage);
            }
        }
        catch
        {
            responseMessage = "An error occurred connecting to the server.";
            toastService.ShowError(responseMessage);
        }
    }
}
