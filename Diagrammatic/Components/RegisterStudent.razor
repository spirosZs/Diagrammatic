@page "/register-student"
@using Diagrammatic2.Components.Shared.Requests
@using Diagrammatic2.Components.Shared.Responses
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager
@inject IToastService toastService
@attribute [AllowAnonymous]

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 card shadow-sm p-4">
            <EditForm Model="registrationModel" OnValidSubmit="RegisterUser">
                <DataAnnotationsValidator />
                <h2 class="text-center">Create Student Account</h2>
                <p class="text-muted text-center">Join the evaluation session</p>
                <hr />

                <div class="form-floating mb-3">
                    <InputText id="email" @bind-Value="registrationModel.email" class="form-control" autocomplete="username" placeholder="name@example.com" />
                    <label for="email">Email address</label>
                    <ValidationMessage For="@(() => registrationModel.email)" class="text-danger" />
                </div>

                <div class="form-floating mb-3">
                    <InputText id="password" type="password" @bind-Value="registrationModel.password" class="form-control" autocomplete="new-password" placeholder="password" />
                    <label for="password">Password</label>
                    <ValidationMessage For="@(() => registrationModel.password)" class="text-danger" />
                </div>

                @* Hidden role display for debugging or confirmation *@
                <div class="mb-3 text-center">
                    <span class="badge bg-secondary">Account Type: Student</span>
                </div>

                <button type="submit" class="w-100 btn btn-lg btn-primary">Register</button>

                <div class="mt-3 text-center">
                    <a href="login">Already got an account? Log in here.</a>
                </div>

                @if (!string.IsNullOrEmpty(responseMessage))
                {
                    <div class="mt-3 alert alert-warning">@responseMessage</div>
                }
            </EditForm>
        </div>
    </div>
</div>

@code {
    private UserRegistrationRequest registrationModel = new UserRegistrationRequest();
    private string? responseMessage;

    protected override void OnInitialized()
    {
        // Set the role to Student automatically
        // Assuming your Request model uses lowercase 'role' or uppercase 'Role'
        registrationModel.role = "Student";
    }

    private async Task RegisterUser()
    {
        try
        {
            var httpClient = HttpClientFactory.CreateClient("DiagrammaticClient");

            // Ensure the role is set one last time before sending
            registrationModel.role = "Student";

            var response = await httpClient.PostAsJsonAsync("/identity/register", registrationModel);

            if (response.IsSuccessStatusCode)
            {
                toastService.ShowSuccess("Registration successful! Please log in.");
                NavigationManager.NavigateTo("/login");
            }
            else
            {
                var authFailedResponse = await response.Content.ReadFromJsonAsync<AuthFailedResponse>();

                if (authFailedResponse?.Errors != null && authFailedResponse.Errors.Any())
                {
                    responseMessage = string.Join(", ", authFailedResponse.Errors);
                }
                else
                {
                    responseMessage = "Registration failed. Please check your details.";
                }

                toastService.ShowError(responseMessage);
            }
        }
        catch (Exception ex)
        {
            responseMessage = "An error occurred connecting to the server.";
            toastService.ShowError(responseMessage);
        }
    }
}