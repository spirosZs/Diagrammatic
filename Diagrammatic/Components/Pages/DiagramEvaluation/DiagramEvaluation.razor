@page "/diagram-evaluation"
@attribute [AllowAnonymous]

@using System.Net.Http.Json
@using System.Text.Json
@using Diagrammatic_test.Components.Pages.Exercises.Dto
@using Diagrammatic_test.Components.Pages.Exercises.Dto.Diagram
@using Diagrammatic_test.Components.Shared.Dto
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.WebUtilities

@inject IHttpClientFactory HttpClientFactory
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject IToastService toastService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<h3>Diagram Evaluations</h3>

@if (!isAuthorizedWithCode)
{
    <div class="p-3 border rounded shadow-sm">
        <p>Please enter your participation code to continue:</p>

        <InputText @bind-Value="enteredCode" class="form-control mb-2" />
        <button class="btn btn-primary" @onclick="ValidateCode">Submit</button>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <p class="text-danger mt-2">@_errorMessage</p>
        }
    </div>
}
else if (isExamFinished)
{
    <div class="p-3 border rounded shadow-sm text-center">
        <h4>🧾 Upload Results</h4>
        <p>Please upload your saved diagram JSON for each exercise.</p>

        @foreach (var item in completedExercises)
        {
            <div class="mt-3 p-2 border rounded">
                <strong>@item.Name</strong>

                <InputFile OnChange="e => UploadFile(e, item)" />

                @if (item.Score.HasValue)
                {
                    <div class="text-success mt-1">
                        Score: <strong>@item.Score</strong>
                    </div>
                }
            </div>
        }
    </div>
}
else
{
    <div class="p-3 border rounded shadow-sm">
        <h4>@exerciseName</h4>

        @if (isExerciseLoaded)
        {
            <div class="alert alert-info">
                <strong>Time remaining:</strong>
                @($"{remainingSeconds / 60:D2}:{remainingSeconds % 60:D2}")
            </div>

            <iframe src="http://localhost:8083/diagramEvaluation"
                    width="100%" height="600"></iframe>
        }
        else
        {
            <p>Loading exercise...</p>
        }
    </div>
}

@code {

    // ---------------- STATE ----------------
    private bool isAuthorizedWithCode;
    private bool isExerciseLoaded;
    private bool isExamFinished;

    private string enteredCode = "";
    private string? _errorMessage;
    private string? exerciseName;

    private Guid exerciseId;
    private Guid currentGameId;

    private int remainingSeconds;
    private System.Threading.Timer? countdownTimer;
    private bool isTimerRunning;

    private const int PollRetries = 5;
    private const int PollDelayMs = 1000;

    private List<ExerciseResult> completedExercises = new();

    // ---------------- INIT ----------------
    protected override async Task OnInitializedAsync()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("accessToken", out var token))
        {
            if (AuthenticationStateProvider is AuthStateProviderService auth)
            {
                await auth.MarkUserAsAuthenticated(token!);
                await LocalStorage.SetItemAsync("authToken", token!);
            }
        }
    }

    // ---------------- AUTH ----------------
    private async Task ValidateCode()
    {
        var client = await CreateClientAsync();

        var response = await client.PostAsJsonAsync(
            "/api/game/participate",
            new { participationCode = enteredCode });

        if (!response.IsSuccessStatusCode)
        {
            toastService.ShowError("Invalid participation code");
            return;
        }

        var result =
            await response.Content.ReadFromJsonAsync<ParticipationResponse>();

        currentGameId = result!.Id;
        isAuthorizedWithCode = true;

        await LoadGameExerciseAsync(currentGameId);
    }

    // ---------------- EXERCISES ----------------
    private async Task LoadGameExerciseAsync(Guid gameId)
    {
        var client = await CreateClientAsync();
        var response = await client.GetAsync($"/api/game/{gameId}/exercise");

        if (response.StatusCode == System.Net.HttpStatusCode.NoContent)
        {
            await EndExamAsync();
            return;
        }

        var exercise =
            await response.Content.ReadFromJsonAsync<GameExerciseResponse>();

        exerciseId = exercise!.Id;
        exerciseName = exercise.Name;

        await LoadExerciseAsync(exerciseId);
    }

    private async Task LoadExerciseAsync(Guid id)
    {
        isTimerRunning = false;
        countdownTimer?.Dispose();

        var client = await CreateClientAsync();
        var response = await client.GetAsync($"/api/exercise/{id}");

        var exercise =
            await response.Content.ReadFromJsonAsync<ExerciseDto>();

        remainingSeconds = exercise!.TimeToComplete;
        isExerciseLoaded = true;

        StartCountdown();
    }

    // ---------------- TIMER ----------------
    private void StartCountdown()
    {
        countdownTimer?.Dispose();
        isTimerRunning = true;

        countdownTimer = new System.Threading.Timer(async _ =>
        {
            if (!isTimerRunning) return;

            if (remainingSeconds > 0)
            {
                remainingSeconds--;

                if (remainingSeconds == 10)
                    await InvokeAsync(() =>
                        toastService.ShowWarning("⏳ 10 seconds remaining!"));

                await InvokeAsync(StateHasChanged);
                return;
            }

            isTimerRunning = false;
            countdownTimer?.Dispose();

            completedExercises.Add(new ExerciseResult
            {
                ExerciseId = exerciseId,
                Name = exerciseName!
            });

            var next =
                await PollForNextExerciseAsync(currentGameId, exerciseId);

            if (next is null)
                await InvokeAsync(EndExamAsync);
            else
            {
                exerciseId = next.Id;
                exerciseName = next.Name;
                await InvokeAsync(() => LoadExerciseAsync(exerciseId));
            }

        }, null, 1000, 1000);
    }

    private async Task<GameExerciseResponse?> PollForNextExerciseAsync(
        Guid gameId, Guid previousId)
    {
        var client = await CreateClientAsync();

        for (int i = 0; i < PollRetries; i++)
        {
            var response =
                await client.GetAsync($"/api/game/{gameId}/exercise");

            if (response.StatusCode == System.Net.HttpStatusCode.NoContent)
                return null;

            var next =
                await response.Content.ReadFromJsonAsync<GameExerciseResponse>();

            if (next!.Id != previousId)
                return next;

            await Task.Delay(PollDelayMs);
        }

        return null;
    }

    private async Task EndExamAsync()
    {
        isTimerRunning = false;
        countdownTimer?.Dispose();

        isExamFinished = true;
        isExerciseLoaded = false;

        toastService.ShowSuccess("🎉 Exam completed!");
        await InvokeAsync(StateHasChanged);
    }

    // ---------------- UPLOAD + COMPARE ----------------
    // DTO for the compare API
    private class DiagramCompareRequestDto
    {
        public DiagramDefinitionDto Correct { get; set; } = default!;
        public DiagramDefinitionDto Input { get; set; } = default!;
    }

    private async Task UploadFile(InputFileChangeEventArgs e, ExerciseResult item)
    {
        try
        {
            toastService.ShowInfo($"Reading file for {item.Name}...");

            using var reader = new StreamReader(e.File.OpenReadStream(long.MaxValue));
            var inputJson = await reader.ReadToEndAsync();

            var client = await CreateClientAsync();

            var exercise = await client.GetFromJsonAsync<DiagramExerciseDto>(
                $"/api/exercise/{item.ExerciseId}");

            if (exercise?.Diagram == null || string.IsNullOrWhiteSpace(exercise.Diagram.Definition))
            {
                toastService.ShowError("Exercise diagram is missing or empty.");
                return;
            }

            toastService.ShowInfo("Normalizing diagrams...");

            var payload = new DiagramCompareRequestDto
            {
                Correct = ExtractDiagramDefinitionFromUpload(exercise.Diagram.Definition),
                Input = ExtractDiagramDefinitionFromUpload(inputJson)
            };

            toastService.ShowInfo("Comparing diagrams...");
            Console.WriteLine(JsonSerializer.Serialize(payload, new JsonSerializerOptions { WriteIndented = true }));

            var response = await client.PostAsJsonAsync(
                "/api/diagram/compare",
                payload,
                new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = null }
            );

            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                toastService.ShowError($"Compare API failed: {error}");
                return;
            }

            item.Score = await response.Content.ReadFromJsonAsync<int>();
            toastService.ShowSuccess($"Score for {item.Name}: {item.Score}");
        }
        catch (Exception ex)
        {
            toastService.ShowError($"Compare error: {ex.Message}");
        }
    }



    /// <summary>
    /// Safely extracts diagram definition from raw JSON.
    /// Handles missing annotations or empty nodes/connectors.
    /// </summary>
    private DiagramDefinitionDto ExtractDiagramDefinitionFromUpload(string rawJson)
    {
        // If the JSON is a string (from API), unescape it first
        if (rawJson.TrimStart().StartsWith("\""))
        {
            rawJson = JsonSerializer.Deserialize<string>(rawJson)!;
        }

        using var doc = JsonDocument.Parse(rawJson);
        var root = doc.RootElement;

        var nodes = new List<NodeDefinitionDto>();
        var connectors = new List<ConnectorDefinitionDto>();
        var map = new Dictionary<string, NodeDefinitionDto>();

        // ----------------- Nodes -----------------
        if (root.TryGetProperty("nodes", out var nodesElement))
        {
            foreach (var n in nodesElement.EnumerateArray())
            {
                var id = n.GetProperty("id").GetString() ?? Guid.NewGuid().ToString();

                string content = "";
                if (n.TryGetProperty("annotations", out var annos))
                {
                    var firstAnno = annos.EnumerateArray().FirstOrDefault();
                    if (firstAnno.ValueKind != JsonValueKind.Undefined &&
                        firstAnno.TryGetProperty("content", out var contentProp))
                    {
                        content = contentProp.GetString() ?? "";
                    }
                }

                var node = new NodeDefinitionDto
                {
                    Id = id,
                    Annotations =
                {
                    new NodeAnnotationDto
                    {
                        Id = Guid.NewGuid().ToString(),
                        Content = content
                    }
                }
                };

                nodes.Add(node);
                map[id] = node;
            }
        }

        // ----------------- Connectors -----------------
        if (root.TryGetProperty("connectors", out var connElement))
        {
            foreach (var c in connElement.EnumerateArray())
            {
                var id = c.GetProperty("id").GetString() ?? Guid.NewGuid().ToString();
                var sourceId = c.GetProperty("sourceID").GetString();
                var targetId = c.GetProperty("targetID").GetString();

                if (sourceId != null && targetId != null)
                {
                    if (map.TryGetValue(sourceId, out var sourceNode))
                        sourceNode.OutEdges.Add(id);
                    if (map.TryGetValue(targetId, out var targetNode))
                        targetNode.InEdges.Add(id);
                }

                connectors.Add(new ConnectorDefinitionDto { Id = id });
            }
        }

        return new DiagramDefinitionDto
        {
            Nodes = nodes,
            Connectors = connectors
        };
    }




    private async Task<HttpClient> CreateClientAsync()
    {
        var client =
            HttpClientFactory.CreateClient("DiagrammaticClient");

        var token =
            await LocalStorage.GetItemAsync<string>("authToken");

        if (!string.IsNullOrEmpty(token))
            client.DefaultRequestHeaders.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

        return client;
    }

    // ---------------- MODELS ----------------
    private class ExerciseResult
    {
        public Guid ExerciseId { get; set; }
        public string Name { get; set; } = "";
        public int? Score { get; set; }
    }

    private class ParticipationResponse
    {
        public Guid Id { get; set; }
    }

    private class GameExerciseResponse
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = "";
    }
}
