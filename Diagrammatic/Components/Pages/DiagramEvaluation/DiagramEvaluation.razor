@page "/diagram-evaluation"
@attribute [AllowAnonymous]
@using System.Net.Http.Json
@using Diagrammatic_test.Components.Pages.Exercises.Dto
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.WebUtilities
@inject IHttpClientFactory HttpClientFactory
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject IToastService toastService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<h3>Diagram Evaluations</h3>

@if (!isAuthorizedWithCode)
{
    <div class="p-3 border rounded shadow-sm">
        <p>Please enter your participation code to continue:</p>

        <InputText @bind-Value="enteredCode" placeholder="Enter code" class="form-control mb-2" />
        <button class="btn btn-primary" @onclick="ValidateCode">Submit</button>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <p class="text-danger mt-2">@_errorMessage</p>
        }
    </div>
}
else if (isExamFinished)
{
    <div class="p-3 border rounded shadow-sm text-center">
        <h4>✅ Exam Completed!</h4>
        <p>Thank you for participating. You may close this page now.</p>
    </div>
}
else
{
    <div class="p-3 border rounded shadow-sm">
        <h4>@exerciseName</h4>

        @if (isExerciseLoaded)
        {
            <div class="alert alert-info">
                <strong>Time remaining:</strong>
                @($"{remainingSeconds / 60:D2}:{remainingSeconds % 60:D2}")
            </div>

            <iframe src="http://localhost:8083/diagramEvaluation" width="100%" height="600"></iframe>
        }
        else
        {
            <p>Loading exercise...</p>
        }
    </div>
}

@code {
    private bool isAuthorizedWithCode = false;
    private bool isExerciseLoaded = false;
    private bool isExamFinished = false;
    private string enteredCode = "";
    private string? _errorMessage;
    private string? exerciseName;
    private Guid exerciseId;
    private Guid currentGameId;
    private int remainingSeconds;
    private System.Threading.Timer? countdownTimer;
    private bool isTimerRunning = false;

    private const int PollRetries = 5;
    private const int PollDelayMs = 1000;

    protected override async Task OnInitializedAsync()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("accessToken", out var token))
        {
            if (AuthenticationStateProvider is AuthStateProviderService authProvider)
            {
                await authProvider.MarkUserAsAuthenticated(token!);
                await LocalStorage.SetItemAsync("authToken", token!);
            }
        }
    }

    private async Task ValidateCode()
    {
        try
        {
            var token = await LocalStorage.GetItemAsync<string>("authToken");
            var httpClient = HttpClientFactory.CreateClient("DiagrammaticClient");

            if (!string.IsNullOrEmpty(token))
            {
                httpClient.DefaultRequestHeaders.Authorization =
                    new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            }

            var payload = new { participationCode = enteredCode };
            var response = await httpClient.PostAsJsonAsync("/api/game/participate", payload);

            if (response.IsSuccessStatusCode)
            {
                var participateResult = await response.Content.ReadFromJsonAsync<ParticipationResponse>();
                if (participateResult is not null)
                {
                    isAuthorizedWithCode = true;
                    _errorMessage = null;
                    toastService.ShowSuccess("Participation code accepted.");

                    currentGameId = participateResult.Id;
                    await LoadGameExerciseAsync(currentGameId);
                }
                else
                {
                    _errorMessage = "Invalid response from server.";
                }
            }
            else
            {
                var errorText = await response.Content.ReadAsStringAsync();
                _errorMessage = $"Invalid participation code. {errorText}";
                toastService.ShowError(_errorMessage);
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error validating code: {ex.Message}";
            toastService.ShowError(_errorMessage);
        }
    }

    private async Task LoadGameExerciseAsync(Guid gameId)
    {
        try
        {
            var token = await LocalStorage.GetItemAsync<string>("authToken");
            var httpClient = HttpClientFactory.CreateClient("DiagrammaticClient");

            if (!string.IsNullOrEmpty(token))
            {
                httpClient.DefaultRequestHeaders.Authorization =
                    new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            }

            var response = await httpClient.GetAsync($"/api/game/{gameId}/exercise");

            if (response.StatusCode == System.Net.HttpStatusCode.NoContent)
            {
                await EndExamAsync();
                return;
            }

            if (response.IsSuccessStatusCode)
            {
                var exerciseResponse = await response.Content.ReadFromJsonAsync<GameExerciseResponse>();
                if (exerciseResponse is null || exerciseResponse.Id == Guid.Empty)
                {
                    await EndExamAsync();
                    return;
                }

                exerciseId = exerciseResponse.Id;
                exerciseName = exerciseResponse.Name;

                await LoadExerciseAsync(exerciseId);
            }
            else
            {
                _errorMessage = $"Failed to load game exercise (status: {response.StatusCode}).";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error loading game exercise: {ex.Message}";
        }
    }

    private async Task LoadExerciseAsync(Guid id)
    {
        isTimerRunning = false;
        countdownTimer?.Dispose();
        countdownTimer = null;

        try
        {
            var token = await LocalStorage.GetItemAsync<string>("authToken");
            var httpClient = HttpClientFactory.CreateClient("DiagrammaticClient");

            if (!string.IsNullOrEmpty(token))
            {
                httpClient.DefaultRequestHeaders.Authorization =
                    new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            }

            var response = await httpClient.GetAsync($"/api/exercise/{id}");
            if (response.IsSuccessStatusCode)
            {
                var exerciseResponse = await response.Content.ReadFromJsonAsync<ExerciseDto>();
                if (exerciseResponse is not null)
                {
                    isExerciseLoaded = true;
                    remainingSeconds = exerciseResponse.TimeToComplete;
                    StartCountdown();

                    toastService.ShowSuccess($"Loaded exercise: {exerciseName}");
                }
            }
            else
            {
                _errorMessage = $"Failed to load exercise (status: {response.StatusCode}).";
                toastService.ShowError(_errorMessage);
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error loading exercise: {ex.Message}";
            toastService.ShowError(_errorMessage);
        }
    }

    private void StartCountdown()
    {
        countdownTimer?.Dispose();
        isTimerRunning = true;

        countdownTimer = new System.Threading.Timer(async _ =>
        {
            if (!isTimerRunning)
                return;

            if (remainingSeconds > 0)
            {
                remainingSeconds--;
                await InvokeAsync(StateHasChanged);
                return;
            }

            // Timer reached zero
            isTimerRunning = false;
            countdownTimer?.Dispose();
            await InvokeAsync(() => toastService.ShowInfo("Exercise time completed. Checking for next exercise..."));

            var next = await PollForNextExerciseAsync(currentGameId, exerciseId);

            if (next is null)
            {
                await InvokeAsync(async () => await EndExamAsync());
            }
            else
            {
                exerciseId = next.Id;
                exerciseName = next.Name;
                await InvokeAsync(async () => await LoadExerciseAsync(exerciseId));
            }
        }, null, 1000, 1000);
    }

    private async Task<GameExerciseResponse?> PollForNextExerciseAsync(Guid gameId, Guid previousId)
    {
        var token = await LocalStorage.GetItemAsync<string>("authToken");
        var httpClient = HttpClientFactory.CreateClient("DiagrammaticClient");
        if (!string.IsNullOrEmpty(token))
        {
            httpClient.DefaultRequestHeaders.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
        }

        GameExerciseResponse? lastResponse = null;

        for (int i = 0; i < PollRetries; i++)
        {
            try
            {
                var response = await httpClient.GetAsync($"/api/game/{gameId}/exercise");
                if (response.StatusCode == System.Net.HttpStatusCode.NoContent)
                {
                    return null;
                }

                if (response.IsSuccessStatusCode)
                {
                    var next = await response.Content.ReadFromJsonAsync<GameExerciseResponse>();
                    if (next is null || next.Id == Guid.Empty)
                        return null;

                    if (next.Id != previousId)
                        return next;

                    lastResponse = next;
                }
            }
            catch
            {
                // ignore transient errors
            }

            await Task.Delay(PollDelayMs);
        }

        // After all retries, still same ID — end game
        await EndGameOnServerAsync(gameId);
        return null;
    }

    private async Task EndGameOnServerAsync(Guid gameId)
    {
        try
        {
            var token = await LocalStorage.GetItemAsync<string>("authToken");
            var httpClient = HttpClientFactory.CreateClient("DiagrammaticClient");
            if (!string.IsNullOrEmpty(token))
            {
                httpClient.DefaultRequestHeaders.Authorization =
                    new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            }

            var response = await httpClient.PostAsync($"/api/game/{gameId}/end", null);
            if (response.IsSuccessStatusCode)
            {
                await InvokeAsync(() => toastService.ShowSuccess("Exam ended successfully."));
            }
            else
            {
                await InvokeAsync(() => toastService.ShowWarning($"Exam ended locally, but server responded {response.StatusCode}."));
            }
        }
        catch (Exception ex)
        {
            await InvokeAsync(() => toastService.ShowError($"Failed to end game: {ex.Message}"));
        }
    }

    private async Task EndExamAsync()
    {
        isTimerRunning = false;
        countdownTimer?.Dispose();
        isExamFinished = true;
        isExerciseLoaded = false;

        await InvokeAsync(StateHasChanged);
        toastService.ShowSuccess("🎉 Exam completed!");
    }

    public void Dispose()
    {
        isTimerRunning = false;
        countdownTimer?.Dispose();
    }

    private class ParticipationResponse
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
    }

    private class GameExerciseResponse
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string ProblemType { get; set; } = string.Empty;
        public int Weight { get; set; }
        public int TimeToComplete { get; set; }
        public string Category { get; set; } = string.Empty;
        public DateTime Created { get; set; }
        public Guid ExerciseCollectionId { get; set; }
    }
}
