@page "/diagram-evaluation"
@attribute [AllowAnonymous]
@implements IAsyncDisposable

@using System.Net.Http.Json
@using System.Text.Json
@using Diagrammatic_test.Components.Pages.Exercises.Dto
@using Diagrammatic_test.Components.Pages.Exercises.Dto.Diagram
@using Diagrammatic_test.Components.Shared.Dto
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.AspNetCore.WebUtilities

@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JS
@inject Blazored.SessionStorage.ISessionStorageService SessionStorage
@inject IToastService toastService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IOptions<ApiOptions> ApiOptions

<div class="eval-page">

    <header class="eval-head">
        <div class="eval-head-text">
            <h1 class="eval-title">Diagram evaluation</h1>
            <p class="eval-subtitle">@StatusText</p>
        </div>

        @if (isAuthorizedWithCode && gameStarted && !isExamFinished && !roundTimedOut)
        {
            <span class="eval-live"><span class="eval-live-dot"></span>Live</span>
        }
    </header>

    @if (!isAuthorizedWithCode)
    {
        <section class="eval-card eval-card--narrow eval-card--center">
            <div class="eval-badge eval-badge--accent"><i class="bi bi-key-fill"></i></div>
            <h2 class="eval-card-title">Join the session</h2>
            <p class="eval-card-text">Enter the participation code your teacher shared with the class.</p>

            <InputText @bind-Value="enteredCode"
                       class="form-control eval-code-input"
                       placeholder="Participation code"
                       autocomplete="off"
                       autocapitalize="characters"
                       spellcheck="false" />

            <button class="btn btn-primary eval-btn-block" @onclick="ValidateCode">
                Continue <i class="bi bi-arrow-right"></i>
            </button>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <p class="eval-error">@_errorMessage</p>
            }
        </section>
    }
    else if (isExamFinished)
    {
        <section class="eval-card">
            <div class="eval-card-head">
                <div class="eval-badge eval-badge--success"><i class="bi bi-clipboard-check"></i></div>
                <div>
                    <h2 class="eval-card-title">All done</h2>
                    <p class="eval-card-text">
                        @if (PendingSubmissions.Any())
                        {
                            <text>
                                Your answers were sent in automatically as each round ended.
                                One or more are still going out — leave this page open until
                                they're all confirmed.
                            </text>
                        }
                        else
                        {
                            <text>
                                Your answers were sent in automatically as each round ended.
                                There's nothing left to do.
                            </text>
                        }
                    </p>
                </div>
            </div>

            <ul class="eval-list">
                @foreach (var item in completedExercises)
                {
                    <li class="eval-item">
                        <div class="eval-item-main">
                            <span class="eval-item-name">@item.Name</span>

                            <div class="eval-chips">
                                @if (item.Submitted)
                                {
                                    <span class="eval-chip eval-chip--ok">
                                        <i class="bi bi-send-check"></i> Submitted
                                    </span>
                                }
                                else if (item.HasAnswer)
                                {
                                    <span class="eval-chip eval-chip--info">
                                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                        Sending…
                                    </span>
                                }
                                else
                                {
                                    <span class="eval-chip eval-chip--warn">
                                        <i class="bi bi-exclamation-triangle-fill"></i> Capture failed
                                    </span>
                                }

                                @if (item.DanglingConnectors > 0)
                                {
                                    <span class="eval-chip eval-chip--warn">
                                        <i class="bi bi-exclamation-triangle-fill"></i>
                                        @item.DanglingConnectors loose arrow(s) — not scored
                                    </span>
                                }
                            </div>

                            @if (!item.Submitted && !string.IsNullOrEmpty(item.SubmitError))
                            {
                                <p class="eval-error">@item.SubmitError — retrying automatically.</p>
                            }

                            @* Last-resort recovery: only when nothing could be captured
                               from the editor. Uploading sends the answer straight away —
                               there is no separate submit step. A path answer is typed, not
                               captured, so it can never land here and the JSON upload would
                               make no sense for it. *@
                            @if (!item.HasAnswer && item.Category == "diagram")
                            {
                                <div class="eval-upload">
                                    <label class="eval-upload-label">Upload your saved diagram JSON instead</label>
                                    <InputFile OnChange="e => UploadFile(e, item)" class="form-control form-control-sm" />
                                </div>
                            }
                        </div>

                        @if (item.Score.HasValue)
                        {
                            <div class="eval-score">
                                <span class="eval-score-value">@item.Score</span>
                                <span class="eval-score-label">score</span>
                            </div>
                        }
                    </li>
                }
            </ul>
        </section>
    }
    else if (!gameStarted)
    {
        <section class="eval-card eval-card--center">
            <div class="eval-pulse"><i class="bi bi-hourglass-split"></i></div>
            <h2 class="eval-card-title">Waiting for the teacher</h2>
            <p class="eval-card-text">
                You've joined successfully. The exercise and a shared countdown appear here
                for everyone as soon as the game starts.
            </p>
        </section>
    }
    else if (roundTimedOut)
    {
        <section class="eval-card eval-card--center">
            <div class="eval-pulse eval-pulse--warn"><i class="bi bi-alarm"></i></div>
            <h2 class="eval-card-title">Time's up!</h2>
            <p class="eval-card-text">
                Your answer for <strong>@exerciseName</strong> has been submitted. Waiting for
                the teacher to move on to the next exercise…
            </p>
        </section>
    }
    else if (exerciseCategory == "diagram")
    {
        <section class="eval-stage @(stageExpanded ? "is-expanded" : null)">

            <div class="eval-stage-bar">
                <div class="eval-stage-title" title="@exerciseName">@exerciseName</div>

                <div class="eval-timer @TimerState">
                    <i class="bi bi-stopwatch"></i>
                    <span class="eval-timer-value">@ClockText</span>
                </div>

                <button type="button"
                        class="eval-icon-btn"
                        @onclick="ToggleStage"
                        title="@(stageExpanded ? "Exit full screen" : "Full screen")"
                        aria-label="@(stageExpanded ? "Exit full screen" : "Full screen")">
                    <i class="bi @(stageExpanded ? "bi-fullscreen-exit" : "bi-arrows-fullscreen")"></i>
                </button>
            </div>

            <div class="eval-progress" role="progressbar" aria-label="Time remaining"
                 aria-valuemin="0" aria-valuemax="@_roundTotalSeconds" aria-valuenow="@remainingSeconds">
                <div class="eval-progress-bar @TimerState" style="width:@ProgressWidth"></div>
            </div>

            @* The exercise definition is deliberately NOT shown here: the teacher
               reads it out from their own live view (GameStart.razor), so the
               student's stage stays entirely given over to the editor. *@

            <div class="eval-frame">
                <iframe id="diagramFrame"
                        title="Diagram editor"
                        src="@ApiOptions.Value.DiagramEditorUrl"
                        allow="fullscreen"></iframe>
            </div>
        </section>
    }
    else
    {
        @* "path" exercises — and the fallback for anything that isn't a diagram *@
        <section class="eval-card">
            <div class="eval-stage-bar eval-stage-bar--plain">
                <div class="eval-stage-title" title="@exerciseName">@exerciseName</div>

                <div class="eval-timer @TimerState">
                    <i class="bi bi-stopwatch"></i>
                    <span class="eval-timer-value">@ClockText</span>
                </div>
            </div>

            <div class="eval-progress" role="progressbar" aria-label="Time remaining"
                 aria-valuemin="0" aria-valuemax="@_roundTotalSeconds" aria-valuenow="@remainingSeconds">
                <div class="eval-progress-bar @TimerState" style="width:@ProgressWidth"></div>
            </div>

            @if (!string.IsNullOrWhiteSpace(diagramDefinition))
            {
                <p class="eval-lead">@diagramDefinition</p>
            }

            @* The exercise image is deliberately NOT shown here. It lives on the teacher's
               live view (GameStart.razor), which is what the class is looking at, the same
               way a diagram exercise's definition does. *@

            @* Scoring is an exact match of each line against the teacher's paths, so the
               expected shape has to be spelled out — a student who writes prose here
               scores zero no matter how well they understood the diagram. *@
            <label class="eval-upload-label" for="pathAnswer">
                Your answer — one path per line, e.g. <code>1 2 5 6 9</code>
            </label>
            @* Deliberately NOT @bind. Two-way binding renders a value attribute, and this
               component re-renders about once a second for the countdown; every one of
               those renders rewrites the box from the server's copy of the field, so any
               keystroke still in flight is wiped from the DOM. That is how a typed
               "1 2 3" reached the server as "1". Binding on the default onchange is no
               better — it only commits on blur, and a student typing up to the buzzer
               never blurs, which sent an empty answer.

               Writing the field from oninput without ever rendering value leaves the DOM
               as the single source of truth for what the student sees, and no re-render
               can touch it. @key gives each round a fresh element, which is what clears
               the box between rounds now that nothing pushes a value into it. *@
            @* The placeholder comes from a constant rather than a literal: a plain attribute
               value would have its ampersand encoded, so "&#10;" showed up verbatim in the
               box instead of becoming a line break. *@
            <textarea id="pathAnswer"
                      @key="exerciseId"
                      class="form-control"
                      rows="5"
                      placeholder="@PathAnswerPlaceholder"
                      @oninput="OnPathAnswerInput"></textarea>
            <p class="eval-hint">Your answer is submitted automatically when the round ends.</p>
        </section>
    }

</div>

@code {

    // ---------------- STATE ----------------
    private bool isAuthorizedWithCode;
    private bool gameStarted;
    private bool isExamFinished;

    // The local, display-only countdown reached zero, but the server has not
    // advanced the round yet. The student's answer is captured and locked; we
    // show a "waiting for the next exercise" screen until SignalR reports the
    // next round (RefreshGameStateAsync) or the end of the game (EndExamAsync).
    private bool roundTimedOut;

    // True when the current exercise is the last one of the exam. When its timer
    // expires the client ends the game itself rather than waiting for the
    // server's Ended broadcast.
    private bool isLastRound;

    private string enteredCode = "";
    private string? _errorMessage;
    private string? exerciseName;

    private Guid exerciseId;
    private Guid currentGameId;

    // The shared, server-authoritative deadline for the current exercise.
    // Derived from GameInfoDto.DateTimeToNextExercise so every participant
    // counts down to the same instant.
    private DateTime? _deadline;
    private int remainingSeconds;
    private bool _warned;

    private System.Threading.Timer? countdownTimer;

    // Bumped every time the display timer is (re)started or torn down. Each timer
    // callback captures the generation it was created under and no-ops once a
    // newer round supersedes it, so a round's expiry can never act on the next
    // round's state (that race previously bounced students to the submit screen
    // a round early, and let a stale callback dispose the new round's timer).
    private int _timerGeneration;

    private HubConnection? _hub;

    private List<ExerciseResult> completedExercises = new();

    // ---------- EXERCISE / DIAGRAM ----------
    private string? exerciseCategory;
    private string? diagramDefinition; // path: question/lead text
    private string? pathAnswer;


    // ---------- PRESENTATION ----------
    // The editor is embedded in an iframe, so it can only grow as tall as the
    // page lets it. On a phone that leaves a postage-stamp canvas, so the stage
    // can be blown up to fill the viewport (pure CSS overlay — the iframe
    // element is never re-created, which would wipe the student's drawing).
    private bool stageExpanded;

    // Round length, used only to draw the countdown progress bar. Captured when
    // a new round's timer starts (and widened if the teacher extends the round).
    private int _roundTotalSeconds = 1;
    private Guid _timerRoundId;

    private void ToggleStage() => stageExpanded = !stageExpanded;

    private string ClockText => $"{remainingSeconds / 60:D2}:{remainingSeconds % 60:D2}";

    private string TimerState =>
        remainingSeconds <= 10 ? "is-critical" :
        remainingSeconds <= 30 ? "is-warning" : "is-normal";

    private string ProgressWidth
    {
        get
        {
            var total = Math.Max(_roundTotalSeconds, 1);
            var pct = Math.Clamp(remainingSeconds * 100.0 / total, 0, 100);
            return pct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "%";
        }
    }

    private string StatusText
    {
        get
        {
            if (!isAuthorizedWithCode) return "Enter your code to join the session.";
            if (isExamFinished)
                return PendingSubmissions.Any()
                    ? "All rounds finished — sending your remaining answers."
                    : "All rounds finished — every answer was submitted.";
            if (!gameStarted) return "You're in the lobby. Hang tight.";
            if (roundTimedOut) return "Answer submitted. Waiting for the next exercise.";
            return "Draw your answer — it's submitted automatically when the timer ends.";
        }
    }

    // ---------------- INIT ----------------
    protected override async Task OnInitializedAsync()
    {
        // 1. Check Authentication State
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        // 2. If not logged in, redirect to register-student
        if (user.Identity == null || !user.Identity.IsAuthenticated)
        {
            // We pass the current URL as a returnUrl so they can come back after registering/logging in
            NavigationManager.NavigateTo("/register-student?returnUrl=/diagram-evaluation");
            return;
        }

        // --- YOUR EXISTING LOGIC BELOW ---
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);

        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("accessToken", out var token))
        {
            if (AuthenticationStateProvider is AuthStateProviderService auth)
            {
                await auth.MarkUserAsAuthenticated(token!);
                await SessionStorage.SetItemAsync("authToken", token!);
            }
        }
    }

    // ---------------- AUTH ----------------
    private async Task ValidateCode()
    {
        var client = await CreateClientAsync();

        var response = await client.PostAsJsonAsync(
            "/api/game/participate",
            new { participationCode = enteredCode });

        if (!response.IsSuccessStatusCode)
        {
            toastService.ShowError("Invalid participation code");
            return;
        }

        var result =
            await response.Content.ReadFromJsonAsync<ParticipationResponse>();

        currentGameId = result!.Id;
        isAuthorizedWithCode = true;

        // Listen for live game events, then sync immediately in case the
        // teacher has already started the game before this student joined.
        await ConnectToHubAsync();
        await RefreshGameStateAsync();
        StartWatchdog();
    }

    // ---------------- SIGNALR ----------------
    private async Task ConnectToHubAsync()
    {
        if (_hub is not null) return;

        // Read the token on the UI thread (JS interop) and capture it; the
        // SignalR negotiation runs off the circuit's JS context.
        var token = await SessionStorage.GetItemAsync<string>("authToken");

        _hub = new HubConnectionBuilder()
            .WithUrl(ApiOptions.Value.HubUrl, options =>
            {
                options.AccessTokenProvider = () => Task.FromResult<string?>(token);
            })
            .WithAutomaticReconnect()
            .Build();

        // The server broadcasts "Notify"(eventTypeName, jsonParams) to all clients.
        _hub.On<string, string>("Notify", async (eventType, json) =>
        {
            if (TryGetExamId(json, out var examId) && examId != currentGameId)
                return; // event for a different game

            switch (eventType)
            {
                case "Started":
                case "Updated":
                case "ExerciseCompleted":
                case "ExerciseSkipped":
                case "ExerciseTimeChanged":
                    await InvokeAsync(() => RefreshGameStateAsync());
                    break;
                case "Ended":
                    await InvokeAsync(EndExamAsync);
                    break;
            }
        });

        // After a dropped connection, re-sync (deadline/exercise may have moved on).
        _hub.Reconnected += _ => InvokeAsync(() => RefreshGameStateAsync());

        try
        {
            await _hub.StartAsync();
        }
        catch (Exception ex)
        {
            toastService.ShowError($"Live updates unavailable: {ex.Message}");
        }
    }

    private static bool TryGetExamId(string json, out Guid examId)
    {
        examId = Guid.Empty;
        if (string.IsNullOrWhiteSpace(json)) return false;

        try
        {
            using var doc = JsonDocument.Parse(json);
            foreach (var prop in doc.RootElement.EnumerateObject())
            {
                if (string.Equals(prop.Name, "examId", StringComparison.OrdinalIgnoreCase))
                    return Guid.TryParse(prop.Value.GetString(), out examId);
            }
        }
        catch
        {
            // ignore malformed payloads
        }

        return false;
    }

    // ---------------- GAME STATE ----------------
    // Serializes refreshes. Every mutation of the round state (exerciseId,
    // roundTimedOut, the countdown timer) happens across awaited HTTP calls, so two
    // overlapping refreshes interleave their writes — a burst of SignalR broadcasts
    // arriving while one is in flight could leave the round half-applied. Only one
    // runs at a time; a request that arrives during one is coalesced into a single
    // follow-up rather than dropped, since the in-flight refresh may already have
    // read the API before the newer event was raised.
    private bool _refreshing;
    private bool _refreshQueued;

    private async Task RefreshGameStateAsync(bool silent = false)
    {
        if (_refreshing)
        {
            _refreshQueued = true;
            return;
        }

        _refreshing = true;
        try
        {
            do
            {
                _refreshQueued = false;
                await RefreshGameStateCoreAsync(silent);
            }
            while (_refreshQueued);
        }
        finally
        {
            _refreshing = false;
        }
    }

    // Single source of truth for the started view: pulls the shared deadline,
    // the current exercise, and its diagram definition, then (re)starts the
    // display-only countdown.
    private async Task RefreshGameStateCoreAsync(bool silent)
    {
        try
        {
            var client = await CreateClientAsync();

            var info = await client.GetFromJsonAsync<GameInfoResponse>(
                $"/api/game/{currentGameId}");

            if (info is null) return;

            if (info.HasEnded)
            {
                await EndExamAsync();
                return;
            }

            if (!info.HasStarted)
            {
                // Still in the lobby; keep showing the waiting screen.
                gameStarted = false;
                StateHasChanged();
                return;
            }

            // Current round exercise (same id used in POST /api/game/{id}/start).
            var exResponse = await client.GetAsync($"/api/game/{currentGameId}/exercise");

            if (exResponse.StatusCode == System.Net.HttpStatusCode.NoContent)
            {
                await EndExamAsync();
                return;
            }

            if (!exResponse.IsSuccessStatusCode)
            {
                var errorContent = await exResponse.Content.ReadAsStringAsync();
                _errorMessage = $"Failed to load exercise: {exResponse.StatusCode} - {errorContent}";
                if (!silent) toastService.ShowError(_errorMessage);
                return;
            }

            var exercise = await exResponse.Content.ReadFromJsonAsync<GameExerciseResponse>();

            // The deadline and the current exercise come from two separate requests, and
            // the server can advance the round in between: /api/game/{id} still reports
            // round N's (by now elapsed) deadline while /exercise already reports round
            // N+1. Pairing them started N+1's countdown against a deadline in the past,
            // so it expired within milliseconds — capturing a blank canvas, and on the
            // final round ending the whole exam a round early. Re-read the game info
            // until it describes the exercise we were actually handed.
            var attempts = 0;
            while (info.CurrentExerciseId.HasValue
                   && info.CurrentExerciseId.Value != exercise!.Id
                   && attempts++ < 3)
            {
                info = await client.GetFromJsonAsync<GameInfoResponse>(
                    $"/api/game/{currentGameId}");

                if (info is null) return;

                if (info.HasEnded)
                {
                    await EndExamAsync();
                    return;
                }
            }

            // Still disagreeing after retrying: act on the exercise (the student needs
            // something on screen) but never let an unmatched snapshot end the exam. A
            // stale expiry then parks on the recoverable "time's up" screen instead,
            // which the watchdog re-syncs out of.
            var infoMatchesExercise = !info.CurrentExerciseId.HasValue
                                      || info.CurrentExerciseId.Value == exercise!.Id;

            // Round advanced: snapshot the outgoing exercise so it can be
            // submitted at the end of the game. The editor iframe is only on
            // screen while the round is live — not once its timer has expired
            // (roundTimedOut) or the game has finished — so only try to capture
            // from it in that window.
            var roundAdvanced = exercise!.Id != exerciseId && exerciseId != Guid.Empty;
            var roundWasLive = gameStarted && !isExamFinished && !roundTimedOut;
            var iframeWasLive = roundWasLive && exerciseCategory == "diagram";

            // The worker re-broadcasts ExerciseCompleted (and reconnects fire this
            // too). If it's still the exercise we've already timed out / finished
            // with, do NOT rewind into a fresh countdown that instantly re-expires
            // — that endless re-arming is the "stuck in a loop" symptom. Stay put;
            // only a genuinely new round below moves the student on.
            if (!roundAdvanced && exerciseId != Guid.Empty && (roundTimedOut || isExamFinished))
            {
                // ...with one exception: this round's deadline is now comfortably in
                // the future, so it is genuinely live again and parking the student on
                // the "time's up" screen would lock them out of it. That happens when
                // the teacher extends the round (ExerciseTimeChanged used to be
                // swallowed here), and when we had timed out against a deadline that
                // has since been superseded.
                var roundIsLiveAgain =
                    roundTimedOut && !isExamFinished
                    && info.DateTimeToNextExercise.HasValue
                    && SecondsUntil(info.DateTimeToNextExercise.Value) > 1;

                if (!roundIsLiveAgain)
                    return;

                // The "time's up" screen unmounted the editor iframe, so it remounts
                // blank and the answer captured on expiry no longer matches what the
                // student is looking at. Drop it so the resumed round captures afresh —
                // but only while it is still ours to replace. Once the server has
                // accepted it there is no update endpoint, so re-capturing would submit
                // the same exercise twice; the answer already on record stands.
                var resumed = completedExercises.FirstOrDefault(x => x.ExerciseId == exerciseId);
                if (resumed != null && !resumed.Submitted)
                {
                    resumed.SubmissionData = null;
                    resumed.PathAnswers = null;
                    resumed.Score = null;
                    resumed.DanglingConnectors = 0;
                    resumed.SubmitError = null;
                }
            }

            if (roundAdvanced)
            {
                // The teacher can skip a round before its timer expires, so the answer may
                // not have been captured yet; grab it while the exercise view — the editor
                // iframe, or the answer textarea — is still rendered. (If the timer already
                // fired, the answer is captured and this is a no-op.)
                // exerciseId/exerciseName still hold the OUTGOING round here — they are
                // only advanced further down — so this files the answer correctly.
                if (roundWasLive)
                    await CaptureCurrentAnswerAsync(exerciseId, exerciseName);

                RecordCurrentAsCompleted();
                pathAnswer = null;
            }

            exerciseId = exercise.Id;
            exerciseName = exercise.Name;
            exerciseCategory = exercise.Category;

            // The exercise payload already embeds its diagram (Url + Definition), so read
            // it directly. We intentionally do NOT call GET /api/diagram/{id} here: that
            // endpoint returns 500 for the student role (server-side permission-dictionary
            // bug), which previously aborted this method and left students on the waiting
            // screen instead of transferring to the exercise.
            // Only the definition is read here. The image url on the same object is what the
            // teacher's view renders; the student's screen deliberately does not show it.
            diagramDefinition = exercise.Diagram?.Definition;

            _deadline = info.DateTimeToNextExercise;

            // Used to end the game from the client when this round's timer expires,
            // instead of waiting for the worker's Ended event. The API reports it
            // outright; the timestamp comparison behind it is the legacy signal (for
            // the final exercise the server makes the "next exercise" moment and the
            // "game end" moment identical) and is kept only as a fallback.
            isLastRound = infoMatchesExercise
                          && (info.IsOnLastExercise
                              || (info.DateTimeToNextExercise.HasValue
                                  && info.DateTimeToEnd.HasValue
                                  && info.DateTimeToNextExercise == info.DateTimeToEnd));

            _warned = false;
            gameStarted = true;
            isExamFinished = false; // a new round pulls the student back from the upload screen
            roundTimedOut = false;  // ...and out of the "waiting for next exercise" screen

            StartOrRefreshTimerDisplay();
            StateHasChanged();

            // When both the old and the new round are diagram exercises the
            // iframe element survives the re-render, so round N-1's drawing is
            // still on the canvas — wipe it for the new round.
            if (roundAdvanced && iframeWasLive && exerciseCategory == "diagram")
                await JS.InvokeVoidAsync("diagramInterop.clearDiagram", "diagramFrame");
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error refreshing game state: {ex.Message}";
            if (!silent) toastService.ShowError(_errorMessage);
        }
    }

    // ---------------- WATCHDOG ----------------
    // Leaving a waiting screen depends entirely on a SignalR broadcast, so a dropped
    // or duplicated event — or one that lands before the server has committed the new
    // round — stranded the student there for the rest of the exam (the reported "the
    // second exercise never loads"). This re-syncs from the API while, and only
    // while, we're on a screen that has nothing else to move it on.
    private const int WatchdogIntervalMs = 5000;
    private System.Threading.Timer? watchdogTimer;

    private void StartWatchdog()
    {
        if (watchdogTimer is not null) return;

        watchdogTimer = new System.Threading.Timer(async _ =>
        {
            if (!isAuthorizedWithCode) return;

            // Silent throughout: a poll must not spray toasts on a transient failure —
            // the next tick retries.
            try
            {
                // Once the exam is over the only outstanding work is getting any failed
                // automatic submissions through. There is no button for the student to
                // press, so this is what makes them eventually land.
                if (isExamFinished)
                {
                    if (PendingSubmissions.Any())
                        await InvokeAsync(() => FlushPendingSubmissionsAsync(silent: true));
                    return;
                }

                // A live round is driven by its own countdown; only the lobby and the
                // "waiting for the next exercise" screens are event-dependent.
                if (gameStarted && !roundTimedOut) return;

                await InvokeAsync(() => RefreshGameStateAsync(silent: true));
            }
            catch { /* transient; retried on the next tick */ }
        }, null, WatchdogIntervalMs, WatchdogIntervalMs);
    }

    // ---------------- TIMER (display-only, server-deadline driven) ----------------
    private void StartOrRefreshTimerDisplay()
    {
        countdownTimer?.Dispose();

        UpdateRemaining();

        // Baseline for the countdown bar: the full length of this round. Only
        // reset on a genuinely new round — SignalR re-broadcasts refresh the
        // same round repeatedly and must not rewind the bar to 100%. A longer
        // remaining time than the baseline means the teacher extended the round.
        if (_timerRoundId != exerciseId)
        {
            _timerRoundId = exerciseId;
            _roundTotalSeconds = Math.Max(remainingSeconds, 1);
        }
        else if (remainingSeconds > _roundTotalSeconds)
        {
            _roundTotalSeconds = remainingSeconds;
        }

        // Snapshot the identity of the round this timer belongs to. Both are
        // captured so the callback can tell whether it is still the active timer
        // (generation) and which round it is expiring (roundId).
        var myGeneration = ++_timerGeneration;
        var roundId = exerciseId;

        System.Threading.Timer? myTimer = null;
        myTimer = new System.Threading.Timer(async _ =>
        {
            // A newer round (or teardown) has replaced this timer: stop, and only
            // ever dispose our own timer — never the current countdownTimer, which
            // may already point at the next round's timer.
            if (myGeneration != _timerGeneration)
            {
                myTimer?.Dispose();
                return;
            }

            var expired = UpdateRemaining();

            if (!expired && remainingSeconds <= 10 && !_warned)
            {
                _warned = true;
                await InvokeAsync(() => toastService.ShowWarning("⏳ 10 seconds remaining!"));
            }

            await InvokeAsync(StateHasChanged);

            if (expired)
            {
                myTimer?.Dispose();
                await InvokeAsync(() => OnTimerExpiredAsync(roundId));
            }
        }, null, 0, 1000);

        countdownTimer = myTimer;
    }

    // Seconds from now until a deadline reported by the API. Negative once it's past.
    //
    // The API runs in a UTC Docker container and returns DateStarted/DateTimeToNextExercise
    // as naive timestamps (no offset). Treat them as UTC and compare against UtcNow so the
    // countdown is correct regardless of the Blazor host's local timezone. (Using DateTime.Now
    // here made a host ahead of UTC see the deadline already in the past, so the timer expired
    // instantly and bounced students straight to the submission page.)
    private static int SecondsUntil(DateTime deadline)
    {
        var deadlineUtc = deadline.Kind == DateTimeKind.Unspecified
            ? DateTime.SpecifyKind(deadline, DateTimeKind.Utc)
            : deadline.ToUniversalTime();

        return (int)Math.Ceiling((deadlineUtc - DateTime.UtcNow).TotalSeconds);
    }

    // Recomputes the remaining time from the shared deadline. Returns true when expired.
    private bool UpdateRemaining()
    {
        if (_deadline is null)
        {
            remainingSeconds = 0;
            return true;
        }

        remainingSeconds = Math.Max(0, SecondsUntil(_deadline.Value));
        return remainingSeconds <= 0;
    }

    private async Task OnTimerExpiredAsync(Guid roundId)
    {
        // Stale expiry: the round already moved on (the server advanced and
        // RefreshGameStateAsync loaded the next exercise) before this callback
        // ran, or the exam already ended / this round already timed out. Let the
        // current round's own timer govern instead of ending a round early.
        if (roundId != exerciseId || isExamFinished || roundTimedOut)
            return;

        // Snapshot everything that describes THIS round before the await below. The
        // fields are shared and a concurrent refresh rewrites them for the next round.
        var roundName = exerciseName;
        var roundWasLast = isLastRound;

        // Grab the answer before the view switches — that unmounts the editor
        // iframe (and the drawing with it) or the answer textarea.
        await CaptureCurrentAnswerAsync(roundId, roundName);

        // The capture awaits a JS interop round-trip (up to 3s). The refresh triggered
        // by the server's own round change runs in that window, so by now the round may
        // already have advanced — and continuing would apply this expired round's
        // decision to the new one. That is what ended the exam a full round early:
        // round 1's expiry resumed here, read the freshly-loaded round 2's
        // isLastRound == true, and went straight to the results screen, capturing
        // round 2's untouched canvas as a zero on the way out.
        if (roundId != exerciseId || isExamFinished || roundTimedOut)
            return;

        RecordCompleted(roundId, roundName);

        if (roundWasLast)
        {
            // Last exercise: the game is over. Go straight to the results screen
            // instead of waiting for the worker's Ended event (which may never come).
            await EndExamAsync();
            return;
        }

        // Middle round: the countdown is display-only and the server advances the
        // round. Park the student on a waiting screen (NOT the results view)
        // until SignalR reports the next exercise.
        roundTimedOut = true;
        toastService.ShowInfo("⏰ Time's up! Your answer has been submitted.");
        await InvokeAsync(StateHasChanged);
    }

    private void RecordCurrentAsCompleted() => RecordCompleted(exerciseId, exerciseName);

    // Ensures a result slot exists for a specific round. Keyed by round id rather than
    // by "whatever is current", so a late continuation cannot file one round's work
    // against another.
    private ExerciseResult? RecordCompleted(Guid roundId, string? roundName)
    {
        if (roundId == Guid.Empty) return null;

        var existing = completedExercises.FirstOrDefault(x => x.ExerciseId == roundId);
        if (existing != null) return existing;

        // Only ever called for the round that is current on screen, so the category field
        // still describes this round — the incoming round's is assigned after the capture.
        var item = new ExerciseResult
        {
            ExerciseId = roundId,
            Name = roundName ?? "",
            Category = exerciseCategory
        };

        completedExercises.Add(item);
        return item;
    }

    private async Task EndExamAsync()
    {
        // Ending is terminal, and several paths can reach it (the last round's timer,
        // the worker's Ended broadcast, a refresh that sees HasEnded). Re-running it
        // would re-toast and re-capture for no reason.
        if (isExamFinished) return;

        _timerGeneration++;
        countdownTimer?.Dispose();

        // The teacher can end the game while a round is still live on screen;
        // capture the last answer before the exercise view unmounts. If the
        // round already timed out, the answer is captured and the view is
        // gone, so skip it.
        if (gameStarted && !isExamFinished && !roundTimedOut)
            await CaptureCurrentAnswerAsync(exerciseId, exerciseName);

        RecordCurrentAsCompleted();

        gameStarted = false;
        roundTimedOut = false;
        isExamFinished = true;

        toastService.ShowSuccess("🎉 Exam completed!");
        await InvokeAsync(StateHasChanged);

        // Catch anything whose automatic submission failed mid-game. Loud here: this
        // is the student's last chance to notice something didn't go through, and the
        // watchdog keeps retrying behind this.
        await FlushPendingSubmissionsAsync(silent: false);
    }

    // ---------------- UTIL ----------------

    private async Task<HttpClient> CreateClientAsync()
    {
        var client =
            HttpClientFactory.CreateClient("DiagrammaticClient");

        var token =
            await SessionStorage.GetItemAsync<string>("authToken");

        if (!string.IsNullOrEmpty(token))
            client.DefaultRequestHeaders.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

        return client;
    }

    // Files the answer for a round, whatever kind of round it is. Every place that ends a
    // round goes through here: the two problem types capture from completely different
    // places (a JS round-trip into the editor iframe vs. the textarea already bound to
    // this circuit), and a path round used to fall through the diagram-only capture with
    // its answer simply discarded, so it was never submitted and never scored.
    private async Task CaptureCurrentAnswerAsync(Guid roundId, string? roundName)
    {
        if (exerciseCategory == "diagram")
        {
            await CaptureCurrentDiagramAsync(roundId, roundName);
            return;
        }

        await CaptureCurrentPathAnswerAsync(roundId, roundName);
    }

    // Path rounds need no interop: the textarea is bound straight into this circuit, so
    // the answer is already here. Submitted even when blank — that is a legitimate answer
    // worth zero, and the teacher should see the attempt rather than nothing at all.
    private async Task CaptureCurrentPathAnswerAsync(Guid roundId, string? roundName)
    {
        if (roundId == Guid.Empty) return;

        var item = RecordCompleted(roundId, roundName);
        if (item == null) return;
        if (item.PathAnswers != null) return; // already captured this round

        item.PathAnswers = ParsePathAnswers(pathAnswer);

        await TrySubmitAsync(item, silent: true);
    }

    private const string PathAnswerPlaceholder = "1 2 5 6 9\n1 2 4 6 9";

    // Keeps the field in step with the box on every keystroke. Nothing renders the value
    // back, so this is a one-way write and the student's typing is never disturbed.
    private void OnPathAnswerInput(ChangeEventArgs e) => pathAnswer = e.Value?.ToString();

    // The student writes one path per line (or separated by ';'). Scoring is an exact
    // string match against the teacher's paths, so runs of whitespace inside a path are
    // collapsed to single spaces — "1  2 3" and "1 2 3" are the same answer.
    private static string[] ParsePathAnswers(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return Array.Empty<string>();

        return raw
            .Split(new[] { '\n', '\r', ';' }, StringSplitOptions.RemoveEmptyEntries)
            .Select(NormalizePathAnswer)
            .Where(p => p.Length > 0)
            .ToArray();
    }

    private static string NormalizePathAnswer(string value) =>
        string.Join(" ", value.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries));

    // Pulls the drawing for a specific round out of the editor iframe via the
    // postMessage bridge (diagramInterop.js here, newdiagram.js on the editor side) and
    // submits it, so the student never has to download and re-upload the JSON. Must run
    // while the exercise view — and therefore the iframe — is still rendered.
    //
    // The round is passed in rather than read from exerciseId: the interop below is an
    // await, and a refresh can advance the round while it is in flight. The drawing that
    // comes back belongs to the round we asked for, so that is what it must be filed
    // against — never against whatever happens to be current when it arrives.
    private async Task CaptureCurrentDiagramAsync(Guid roundId, string? roundName)
    {
        if (exerciseCategory != "diagram" || roundId == Guid.Empty) return;

        var item = RecordCompleted(roundId, roundName);
        if (item == null) return;
        if (item.SubmissionData != null) return; // already captured this round

        string? json;
        try
        {
            json = await JS.InvokeAsync<string?>(
                "diagramInterop.getDiagram", "diagramFrame", 3000);
        }
        catch
        {
            json = null; // iframe/interop hiccup — fall through to the soft warning
        }

        if (string.IsNullOrWhiteSpace(json))
        {
            toastService.ShowWarning(
                $"Could not capture the diagram for {item.Name} automatically — you can upload it on the results screen.");
            return;
        }

        // Store the answer FIRST so it is queued for submission even if the POST
        // below fails; FlushPendingSubmissionsAsync retries anything left over.
        try
        {
            item.SubmissionData = ExtractDiagramDefinitionFromUpload(json, out var dangling);
            item.DanglingConnectors = dangling;
        }
        catch
        {
            toastService.ShowWarning(
                $"Could not read the diagram for {item.Name} automatically — you can upload it on the results screen.");
            return;
        }

        // A loose arrow (an endpoint not snapped to a node) contributes nothing
        // to the score, so flag it — the drawing looked connected but isn't.
        if (item.DanglingConnectors > 0)
            toastService.ShowWarning(
                $"{item.Name}: {item.DanglingConnectors} arrow(s) weren't attached to a node and were ignored when scoring.");

        await TrySubmitAsync(item, silent: true);
    }

    // Last-resort recovery on the results screen, shown only when nothing could be
    // captured from the editor. Uploading submits immediately — there is no separate
    // submit step for the student to remember.
    private async Task UploadFile(InputFileChangeEventArgs e, ExerciseResult item)
    {
        try
        {
            toastService.ShowInfo($"Reading file for {item.Name}...");

            using var reader = new StreamReader(e.File.OpenReadStream(long.MaxValue));
            var inputJson = await reader.ReadToEndAsync();

            item.SubmissionData = ExtractDiagramDefinitionFromUpload(inputJson, out var dangling);
            item.DanglingConnectors = dangling;

            if (dangling > 0)
                toastService.ShowWarning(
                    $"{item.Name}: {dangling} arrow(s) aren't attached to a node — reconnect them and re-upload so they count.");

            await TrySubmitAsync(item, silent: false);
        }
        catch (Exception ex)
        {
            toastService.ShowError($"Could not read that file: {ex.Message}");
        }
    }

    // ---------------- SUBMISSION (automatic) ----------------
    // Answers are sent as each round closes rather than in one batch at the end, so
    // the student never has to press anything — and a student who closes the tab
    // early still has every finished round recorded.
    //
    // POST /api/submission scores server-side and returns that score, so this is also
    // where item.Score comes from; there is no separate preview scoring round-trip.
    // There is no update endpoint, so an exercise is submitted at most once: a retry
    // only happens when we know the previous attempt did not succeed.

    // Captured but not yet accepted by the server.
    private IEnumerable<ExerciseResult> PendingSubmissions =>
        completedExercises.Where(x => x.HasAnswer && !x.Submitted);

    // Bounds the POST so a hanging API cannot stall a round transition — the capture
    // happens in the narrow window before the editor iframe is torn down, and the
    // retry path picks up whatever times out here.
    private const int SubmitTimeoutMs = 10000;

    private async Task<bool> TrySubmitAsync(ExerciseResult item, bool silent)
    {
        if (item.Submitted || item.Submitting || !item.HasAnswer) return item.Submitted;

        item.Submitting = true;
        item.SubmitError = null;

        try
        {
            var client = await CreateClientAsync();

            // The two problem types post different shapes into the same Data field: the
            // server picks the plugin off the exercise's ProblemType and deserializes
            // accordingly — a string[] of paths, or the node/connector graph.
            var payload = new SubmissionCreateRequestDto
            {
                Name = $"Submission for {item.Name}",
                ExamId = currentGameId,
                ExerciseId = item.ExerciseId,
                Data = item.PathAnswers is not null
                    ? item.PathAnswers
                    : ToServerDiagramShape(item.SubmissionData!)
            };

            using var cts = new CancellationTokenSource(SubmitTimeoutMs);

            var response = await client.PostAsJsonAsync(
                "/api/submission",
                payload,
                new JsonSerializerOptions { PropertyNamingPolicy = null },
                cts.Token);

            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                item.SubmitError = $"Submit failed ({(int)response.StatusCode})";
                if (!silent) toastService.ShowError($"Submit failed for {item.Name}: {error}");
                return false;
            }

            item.Submitted = true;

            // The server evaluates the submission and returns the authoritative score.
            try
            {
                var created = await response.Content.ReadFromJsonAsync<SubmissionResponse>();
                if (created != null) item.Score = created.Score;
            }
            catch
            {
                // Recorded fine; we just can't show a score. Not worth surfacing.
            }

            if (!silent) toastService.ShowSuccess($"Submitted {item.Name}.");
            return true;
        }
        catch (Exception ex)
        {
            item.SubmitError = "Could not reach the server";
            if (!silent) toastService.ShowError($"Submit error for {item.Name}: {ex.Message}");
            return false;
        }
        finally
        {
            item.Submitting = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    // Retries every answer the server has not accepted yet. Called when the exam ends
    // and from the watchdog, since the student has no button to fall back on.
    private async Task FlushPendingSubmissionsAsync(bool silent)
    {
        foreach (var item in PendingSubmissions.ToList())
        {
            await TrySubmitAsync(item, silent);
        }
    }

    private static SubmissionDiagramDefinition ToServerDiagramShape(DiagramDefinitionDto dto)
    {
        return new SubmissionDiagramDefinition
        {
            Nodes = dto.Nodes.Select(n => new SubmissionNodeDefinition
            {
                Id = n.Id,
                Number = int.TryParse(n.Annotations.FirstOrDefault()?.Content, out var num) ? num : 0,
                InEdges = n.InEdges.ToList(),
                OutEdges = n.OutEdges.ToList()
            }).ToList(),
            Connectors = dto.Connectors.Select(c => new SubmissionConnectorDefinition
            {
                Id = c.Id
            }).ToList()
        };
    }

    private DiagramDefinitionDto ExtractDiagramDefinitionFromUpload(string rawJson, out int danglingConnectors)
    {
        danglingConnectors = 0;

        if (rawJson.TrimStart().StartsWith("\""))
        {
            rawJson = JsonSerializer.Deserialize<string>(rawJson)!;
        }

        using var doc = JsonDocument.Parse(rawJson);
        var root = doc.RootElement;

        var nodes = new List<NodeDefinitionDto>();
        var connectors = new List<ConnectorDefinitionDto>();
        var map = new Dictionary<string, NodeDefinitionDto>();

        if (root.TryGetProperty("nodes", out var nodesElement))
        {
            foreach (var n in nodesElement.EnumerateArray())
            {
                var id = n.GetProperty("id").GetString() ?? Guid.NewGuid().ToString();

                string content = "";

                if (n.TryGetProperty("annotations", out var annos))
                {
                    var firstAnno = annos.EnumerateArray().FirstOrDefault();

                    if (firstAnno.ValueKind != JsonValueKind.Undefined &&
                        firstAnno.TryGetProperty("content", out var contentProp))
                    {
                        content = contentProp.GetString() ?? "";
                    }
                }

                var node = new NodeDefinitionDto
                {
                    Id = id,
                    Annotations =
                {
                    new NodeAnnotationDto
                    {
                        Id = Guid.NewGuid().ToString(),
                        Content = content
                    }
                }
                };

                nodes.Add(node);
                map[id] = node;
            }
        }

        if (root.TryGetProperty("connectors", out var connElement))
        {
            foreach (var c in connElement.EnumerateArray())
            {
                var id = c.GetProperty("id").GetString() ?? Guid.NewGuid().ToString();

                var sourceId = c.TryGetProperty("sourceID", out var srcProp) ? srcProp.GetString() : null;
                var targetId = c.TryGetProperty("targetID", out var tgtProp) ? tgtProp.GetString() : null;

                var sourceAttached = false;
                var targetAttached = false;

                if (!string.IsNullOrEmpty(sourceId) && map.TryGetValue(sourceId, out var sourceNode))
                {
                    sourceNode.OutEdges.Add(id);
                    sourceAttached = true;
                }

                if (!string.IsNullOrEmpty(targetId) && map.TryGetValue(targetId, out var targetNode))
                {
                    targetNode.InEdges.Add(id);
                    targetAttached = true;
                }

                // A connector missing either endpoint adds no edge to the scored
                // graph, so a node it was meant to link can silently disappear.
                // Count it so the student can be warned they'll lose those points.
                if (!sourceAttached || !targetAttached)
                    danglingConnectors++;

                connectors.Add(new ConnectorDefinitionDto { Id = id });
            }
        }

        return new DiagramDefinitionDto
        {
            Nodes = nodes,
            Connectors = connectors
        };
    }

    // ---------------- LIFECYCLE ----------------
    public async ValueTask DisposeAsync()
    {
        _timerGeneration++;
        countdownTimer?.Dispose();
        watchdogTimer?.Dispose();

        if (_hub is not null)
        {
            try { await _hub.DisposeAsync(); }
            catch { /* ignore */ }
        }
    }

    // ---------------- MODELS ----------------
    private class ExerciseResult
    {
        public Guid ExerciseId { get; set; }
        public string Name { get; set; } = "";
        public int? Score { get; set; }

        // The round's category, kept so the results screen can tell what kind of answer
        // this was after the round itself is long gone.
        public string? Category { get; set; }

        // A diagram round's answer: the graph pulled out of the editor.
        public DiagramDefinitionDto? SubmissionData { get; set; }

        // A path round's answer: one string per path, which is the shape the server's
        // PathProblemPlugin deserializes and compares against the teacher's paths.
        public string[]? PathAnswers { get; set; }

        // Whether there is anything to send. Path answers are legitimately empty when the
        // student typed nothing, so this cannot be a "not empty" test.
        public bool HasAnswer => SubmissionData != null || PathAnswers != null;

        // Accepted by the server. Never re-submitted once true — POST /api/submission
        // creates a new row every time and there is no update endpoint, so a retry
        // would leave the teacher looking at duplicate answers.
        public bool Submitted { get; set; }

        // A POST is in flight; keeps the round-end submit and a watchdog retry from
        // racing each other into a duplicate.
        public bool Submitting { get; set; }

        // Why the last attempt failed, shown on the results screen.
        public string? SubmitError { get; set; }

        // Arrows whose source or target wasn't snapped to a node. These are
        // dropped from the scored graph, so they're surfaced as a warning.
        public int DanglingConnectors { get; set; }
    }

    private class SubmissionCreateRequestDto
    {
        public string Name { get; set; } = "";
        public bool Published { get; set; } = true;
        public Guid ExamId { get; set; }
        public Guid ExerciseId { get; set; }
        public object Data { get; set; } = default!;
    }

    private class SubmissionDiagramDefinition
    {
        public List<SubmissionNodeDefinition> Nodes { get; set; } = new();
        public List<SubmissionConnectorDefinition> Connectors { get; set; } = new();
    }

    private class SubmissionNodeDefinition
    {
        public string Id { get; set; } = "";
        public int Number { get; set; }
        public List<string> InEdges { get; set; } = new();
        public List<string> OutEdges { get; set; } = new();
    }

    private class SubmissionConnectorDefinition
    {
        public string Id { get; set; } = "";
    }

    private class ParticipationResponse
    {
        public Guid Id { get; set; }
    }

    private class GameInfoResponse
    {
        public bool HasStarted { get; set; }
        public bool HasEnded { get; set; }
        public DateTime? DateTimeToNextExercise { get; set; }
        public DateTime? DateTimeToEnd { get; set; }

        // The exercise this snapshot describes; used to detect that the round advanced
        // between this response and the /exercise one.
        public Guid? CurrentExerciseId { get; set; }

        // Server-reported round position. IsOnLastExercise tells us outright whether
        // this round's expiry ends the exam.
        public int CurrentExerciseIndex { get; set; }
        public bool IsOnLastExercise { get; set; }
    }

    private class GameExerciseResponse
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = "";
        public string? Category { get; set; }
        public Guid? DiagramId { get; set; }

        // The /api/game/{id}/exercise response embeds the diagram (Url + Definition).
        public DiagramResponse? Diagram { get; set; }
    }

    private class DiagramResponse
    {
        public string? Url { get; set; }
        public string? Definition { get; set; }
    }

    // POST /api/submission response. The server evaluates the answer on create, so
    // this is the authoritative score — the same one the teacher sees.
    private class SubmissionResponse
    {
        public Guid Id { get; set; }
        public int Score { get; set; }
    }

}
