@page "/create-exerciseCollection"
@using Diagrammatic_test.Components.Pages.ExerciseCollection.Dto
@using Microsoft.AspNetCore.Components.Forms
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager
@inject IToastService toastService
@inject Blazored.SessionStorage.ISessionStorageService SessionStorage
@attribute [Authorize(Roles = "Teacher")]

<h3>Create Exercise Collection</h3>

<EditForm Model="_exerciseCollectionCreateDto" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="form-group mb-3">
        <label for="name">Name</label>
        <input id="name" class="form-control" @bind="_exerciseCollectionCreateDto.Name" />
    </div>

    <div class="form-group mb-3">
        <label for="category">Category</label>
        <input id="category" class="form-control" @bind="_exerciseCollectionCreateDto.Category" />
    </div>

    <button type="submit" class="btn btn-primary">Submit</button>
</EditForm>

@code {
    private ExerciseCollectionCreateDto _exerciseCollectionCreateDto = new ExerciseCollectionCreateDto();

    private async Task HandleValidSubmit()
    {
        string token = await SessionStorage.GetItemAsync<string>("authToken");
        if (string.IsNullOrWhiteSpace(token))
        {
            toastService.ShowError("You are not authenticated. Please log in.");
            NavigationManager.NavigateTo("/login");
            return;
        }

        try
        {
            var httpClient = HttpClientFactory.CreateClient("DiagrammaticClient");
            httpClient.DefaultRequestHeaders.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

            var response = await httpClient.PostAsJsonAsync("/api/exerciseCollection", _exerciseCollectionCreateDto);

            if (response.IsSuccessStatusCode)
            {
                toastService.ShowSuccess("Exercise Collection created successfully!");
                _exerciseCollectionCreateDto = new ExerciseCollectionCreateDto(); // reset form
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                toastService.ShowError($"Failed to create collection: {errorContent}");
            }
        }
        catch (Exception ex)
        {
            toastService.ShowError($"Error: {ex.Message}");
        }
    }
}
