@page "/add-exercise-to-collection"
@using Diagrammatic_test.Components.Pages.ExerciseCollection.Dto
@using Diagrammatic_test.Components.Shared.Dto
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager
@inject IToastService toastService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inherits LayoutComponentBase
@attribute [StreamRendering]

<h3>Add Exercise Collection</h3>

<CascadingAuthenticationState>
    <AuthorizeView Context="auth">
        <Authorized >
            @if (_exerciseCollections == null)
            {
                <p>Loading exercise collections...</p>
            }
            else
            {
                <EditForm Model="_requestModel" OnValidSubmit="HandleValidSubmit">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="form-group">
                        <label for="exerciseCollection">Exercise Collection</label>
                        <select id="exerciseCollection" class="form-control" @bind="exerciseCollectionSelected.Id">
                            <option selected disabled>---Select Collection---</option>
                            @foreach (var collection in _exerciseCollections)
                            {
                                <option value="@collection.Id">@collection.Name</option>
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="exercise">Exercise</label>
                        <select id="exercise" class="form-control" @bind="_requestModel.ExerciseId">
                            <option selected disabled>---Select Exercise---</option>
                            @foreach (var exercise in _exercises)
                            {
                                <option value="@exercise.Id">@exercise.Name</option>
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="exercise">Operation</label>
                        <select id="exercise" class="form-control" @bind="_requestModel.Operation">
                            <option selected disabled>---Select Exercise---</option>
                            @foreach (var op in Enum.GetValues<ExerciseCollectionOperation>())
                            {
                                <option value="@op">@op</option>
                            }
              
                        </select>
                    </div>

                    <button type="submit" class="btn btn-primary">Add Exercise</button>
                </EditForm>
                }
        </Authorized>
        <NotAuthorized>
            <p>You are not authorized to view this page.</p>
        </NotAuthorized>
    </AuthorizeView>
</CascadingAuthenticationState>

@if (_errorMessage != null)
{
    toastService.ShowError(_errorMessage);
}

@code {
    private List<ExerciseCollectionDto> _exerciseCollections;
    private List<ExerciseDto> _exercises;
    private ExerciseCreateDto _exerciseCreateDto = new ExerciseCreateDto();
    private string _errorMessage;
    private AddRemoveOnExerciseCollectionDto _requestModel = new AddRemoveOnExerciseCollectionDto();
    private ExerciseCollectionDto exerciseCollectionSelected = new ExerciseCollectionDto();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            if (!authState.User.Identity.IsAuthenticated)
            {
                toastService.ShowError("You are not authorized to view this page.");
                NavigationManager.NavigateTo("/");
                return;
            }

            await LoadExerciseCollections();
            await LoadExercises(); // <-- load exercises here
            StateHasChanged();
        } 
    }

    private async Task LoadExerciseCollections()
    {
        try
        {
            var token = await LocalStorage.GetItemAsync<string>("authToken");
            var httpClient = HttpClientFactory.CreateClient("DiagrammaticClient");
            httpClient.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

            var response = await httpClient.GetAsync("/api/exerciseCollection");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                _exerciseCollections = Newtonsoft.Json.JsonConvert.DeserializeObject<List<ExerciseCollectionDto>>(json);
            }
            else
            {
                _errorMessage = "Failed to load exercise collections.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private async Task LoadExercises()
    {
        try
        {
            var token = await LocalStorage.GetItemAsync<string>("authToken");
            var httpClient = HttpClientFactory.CreateClient("DiagrammaticClient");
            httpClient.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

            var response = await httpClient.GetAsync("/api/exercise"); // Adjust endpoint if needed
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                _exercises = Newtonsoft.Json.JsonConvert.DeserializeObject<List<ExerciseDto>>(json);
            }
            else
            {
                _errorMessage = "Failed to load exercises.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }


    private async Task HandleValidSubmit()
    {
        var token = await LocalStorage.GetItemAsync<string>("authToken");

        try
        {
            var client = HttpClientFactory.CreateClient("DiagrammaticClient");
            client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

            var url = $"/api/exerciseCollection/{exerciseCollectionSelected.Id}/exercises";
            var response = await client.PatchAsJsonAsync(url, _requestModel);

            if (response.IsSuccessStatusCode)
            {
                toastService.ShowSuccess("Exercise successfully added to the collection!");
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                toastService.ShowError($"Failed: {response.StatusCode}\n{errorContent}");
            }
        }
        catch (Exception ex)
        {
            toastService.ShowError($"Exception: {ex.Message}");
        }
    }
}
