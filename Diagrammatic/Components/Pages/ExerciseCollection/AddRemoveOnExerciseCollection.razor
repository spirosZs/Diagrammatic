@page "/add-exercise-to-collection"
@using Diagrammatic_test.Components.Pages.ExerciseCollection.Dto
@using Diagrammatic_test.Components.Pages.Exercises.Dto
@using Diagrammatic_test.Components.Shared.Dto
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager
@inject IToastService toastService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject Blazored.SessionStorage.ISessionStorageService SessionStorage
@inherits LayoutComponentBase
@attribute [StreamRendering]

<h3>Add Exercise Collection</h3>


@if (_exerciseCollections == null)
{
    <p>Loading exercise collections...</p>
}
else
{
    <EditForm Model="_requestModel" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="form-group">
            @switch (_requestModel.Operation)
            {

                case ExerciseCollectionOperation.SetParticipationCode:
                    <div class="form-group">
                        <label for="Exam">Exam ID</label>
                        <select id="Exam" class="form-control" @bind="exerciseCollectionSelected.Id">
                            <option selected disabled>---Select Exam---</option>
                            @foreach (var collection in _exerciseCollections)
                            {
                                <option value="@collection.Id">@collection.Name</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="participationCode">Participation Code</label>
                        <input id="participationCode" class="form-control"
                               @bind="_requestModel.ParticipationCode" />
                    </div>
                    break;

                case ExerciseCollectionOperation.AddExercise:
                case ExerciseCollectionOperation.RemoveExercise:
                    <div class="form-group">
                        <label for="exerciseCollection">Exercise Collection</label>
                        <select id="exerciseCollection" class="form-control" @bind="exerciseCollectionSelected.Id">
                            <option selected disabled>---Select Collection---</option>
                            @foreach (var collection in _exerciseCollections)
                            {
                                <option value="@collection.Id">@collection.Name</option>
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="exercise">Exercise</label>
                        <select id="exercise" class="form-control" @bind="_requestModel.ExerciseId">
                            <option selected disabled>---Select Exercise---</option>
                            @foreach (var exercise in _exercises)
                            {
                                <option value="@exercise.Id">@exercise.Name</option>
                            }
                        </select>
                    </div>
                    break;
            }

            <label for="exercise">Operation</label>
            <select id="exercise" class="form-control" @onchange="OnOperationChanged">
                <option selected disabled>---Select Operation---</option>

                @foreach (var op in Enum.GetValues<ExerciseCollectionOperation>())
                {
                    <option value="@op">@op</option>
                }

            </select>
        </div>
        <br />
        <button type="submit" class="btn btn-primary">Add Exercise</button>
    </EditForm>
}

@if (_errorMessage != null)
{
    toastService.ShowError(_errorMessage);
}

@code {
    private List<ExerciseCollectionDto> _exerciseCollections;
    private List<ExerciseDto> _exercises;
    private ExerciseCreateDto _exerciseCreateDto = new ExerciseCreateDto();
    private string _errorMessage;
    private AddRemoveOnExerciseCollectionDto _requestModel = new AddRemoveOnExerciseCollectionDto();
    private ExerciseCollectionDto exerciseCollectionSelected = new ExerciseCollectionDto();
    public string ParticipationCode;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            if (!authState.User.Identity.IsAuthenticated)
            {
                toastService.ShowError("You are not authorized to view this page.");
                NavigationManager.NavigateTo("/");
                return;
            }

            await LoadExerciseCollections();
            await LoadExercises(); // <-- load exercises here
            StateHasChanged();
        }
    }

    private async Task LoadExerciseCollections()
    {
        try
        {
            var token = await SessionStorage.GetItemAsync<string>("authToken");
            var httpClient = HttpClientFactory.CreateClient("DiagrammaticClient");
            httpClient.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

            var response = await httpClient.GetAsync("/api/exerciseCollection");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                _exerciseCollections = Newtonsoft.Json.JsonConvert.DeserializeObject<List<ExerciseCollectionDto>>(json);
            }
            else
            {
                _errorMessage = "Failed to load exercise collections.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private async Task LoadExercises()
    {
        try
        {
            var token = await SessionStorage.GetItemAsync<string>("authToken");
            var httpClient = HttpClientFactory.CreateClient("DiagrammaticClient");
            httpClient.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

            var response = await httpClient.GetAsync("/api/exercise"); // Adjust endpoint if needed
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                _exercises = Newtonsoft.Json.JsonConvert.DeserializeObject<List<ExerciseDto>>(json);
            }
            else
            {
                _errorMessage = "Failed to load exercises.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }


    private async Task HandleValidSubmit()
    {
        var token = await SessionStorage.GetItemAsync<string>("authToken");
        string url;
        HttpResponseMessage response;
        string responseMessage;

        try
        {
            var client = HttpClientFactory.CreateClient("DiagrammaticClient");
            client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

            if (_requestModel.Operation.Equals(ExerciseCollectionOperation.SetParticipationCode))
            {
                url = $"/api/game/{exerciseCollectionSelected.Id}/update";
                // JSON Patch payload
                var payload = new { participationCode = _requestModel.ParticipationCode };
                response = await client.PostAsJsonAsync(url, payload);
                var text = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"Response: {response.StatusCode}, Body: {text}");
                responseMessage = "Participation Code was set Successfully!";
            }

            else
            {
                url = $"/api/exerciseCollection/{exerciseCollectionSelected.Id}/exercises";
                response = await client.PatchAsJsonAsync(url, _requestModel);
                if (_requestModel.Operation.Equals(ExerciseCollectionOperation.AddExercise))
                    responseMessage = "Exercise successfully added to the collection!";
                else
                    responseMessage = "Exercise successfully deleted to the collection!";
            }

            if (response.IsSuccessStatusCode)
            {
                toastService.ShowSuccess(responseMessage);
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                toastService.ShowError($"Failed: {response.StatusCode}\n{errorContent}");
            }
        }
        catch (Exception ex)
        {
            toastService.ShowError($"Exception: {ex.Message}");
        }
    }

    private async Task OnOperationChanged(ChangeEventArgs e)
    {
        _requestModel.Operation = Enum.Parse<ExerciseCollectionOperation>(e.Value.ToString());

        try
        {
            var selectedOp = Enum.Parse<ExerciseCollectionOperation>(e.Value.ToString());
            _requestModel.Operation = selectedOp;

            var token = await SessionStorage.GetItemAsync<string>("authToken");
            var httpClient = HttpClientFactory.CreateClient("DiagrammaticClient");
            httpClient.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            HttpResponseMessage response;
            if (selectedOp == ExerciseCollectionOperation.AddExercise ||
             selectedOp == ExerciseCollectionOperation.RemoveExercise)
                response = await httpClient.GetAsync("/api/exerciseCollection");
            else
                response = await httpClient.GetAsync("/api/exam");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                _exerciseCollections = Newtonsoft.Json.JsonConvert.DeserializeObject<List<ExerciseCollectionDto>>(json);
            }
            else
            {
                _errorMessage = "Failed to load exercise collections.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private void OnCollectionChanged(ChangeEventArgs e)
    {
        var selectedId = e.Value?.ToString();
        exerciseCollectionSelected.Id = Guid.Parse(selectedId);
    }
}
