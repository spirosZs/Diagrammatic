@page "/register"
@using Diagrammatic2.Components.Shared.Requests
@using Diagrammatic2.Components.Shared.Responses
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager
@inject IToastService toastService
@attribute [AllowAnonymous]

<h1>Register</h1>

<div class="row">
    <div class="col-md-4">
        <EditForm Model="registrationModel" FormName="registerForm">
            <DataAnnotationsValidator />
            <h2>Create a new account.</h2>
            <hr />
            <div class="form-floating mb-3">
                <input id="email" @bind="@registrationModel.email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <label for="email">Email</label>
                <ValidationMessage For="@(() => registrationModel.email)" class="text-danger" />
            </div>
            <div class="form-floating mb-3">
                <input id="password" type="password" @bind="@registrationModel.password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
                <label for="password">Password</label>
                <ValidationMessage For="@(() => registrationModel.password)" class="text-danger" />
            </div>
            <button class="w-100 btn btn-lg btn-primary" @onclick="@RegisterUser" >Register</button>
            <a class="nav-link active" aria-current="page" href="login">Already got an account? Log in here.</a>

            @if (!string.IsNullOrEmpty(responseMessage))
            {
                <div class="mt-3 alert alert-info">@responseMessage</div>
            }
        </EditForm>

        <p> "@registrationModel.role"</p>
    </div>
</div>

@code {
    private UserRegistrationRequest registrationModel = new UserRegistrationRequest();
    private string responseMessage;


    private async Task RegisterUser()
    {
        // Debugging statements to check model values before sending the request
        // Console.WriteLine($"Email: {registrationModel.email}");
        //Console.WriteLine($"Password: {registrationModel.password}");

        var httpClient = HttpClientFactory.CreateClient("DiagrammaticClient");
        var response = await httpClient.PostAsJsonAsync("/identity/register", registrationModel);

        if (response.IsSuccessStatusCode)
        {
            var authSuccessResponse = await response.Content.ReadFromJsonAsync<AuthSuccessResponse>();
            responseMessage = "Registration successful!";
            // responseMessage = $"Registration successful! Token: {authSuccessResponse.Token}";
            // Show a success toast notification
            toastService.ShowSuccess(responseMessage);
            //Navigate to login page
            NavigationManager.NavigateTo("/login");

        }
        else
        {
            var authFailedResponse = await response.Content.ReadFromJsonAsync<AuthFailedResponse>();
            responseMessage = "Registration failed";
            //responseMessage = "Registration failed: " + string.Join(", ", authFailedResponse.Errors);
            toastService.ShowError(responseMessage);
            // Show an error toast notification
        }
    }
}
