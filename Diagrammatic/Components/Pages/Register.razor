@page "/register"
@using Diagrammatic2.Components.Shared.Requests
@using Diagrammatic2.Components.Shared.Responses
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager
@inject IToastService toastService
@attribute [AllowAnonymous]

<PageTitle>Create teacher account · Diagrammatic</PageTitle>

<div class="ds-auth-shell">
    <div class="ds-auth-card">
        <div class="ds-auth-brand">
            <span>Diagrammatic</span>
        </div>

        <h1 class="ds-auth-title">Create teacher account</h1>
        <p class="ds-auth-subtitle">Build exercise collections and run exams for your class.</p>

        <EditForm Model="registrationModel" OnValidSubmit="RegisterUser" FormName="registerForm">
            <DataAnnotationsValidator />

            <div class="form-floating mb-3">
                <InputText id="email"
                           @bind-Value="registrationModel.email"
                           class="form-control"
                           autocomplete="username"
                           placeholder="name@example.com"
                           inputmode="email" />
                <label for="email">Email address</label>
                <ValidationMessage For="@(() => registrationModel.email)" class="validation-message" />
            </div>

            <div class="form-floating mb-4">
                <InputText id="password"
                           type="password"
                           @bind-Value="registrationModel.password"
                           class="form-control"
                           autocomplete="new-password"
                           placeholder="password" />
                <label for="password">Password</label>
                <ValidationMessage For="@(() => registrationModel.password)" class="validation-message" />
            </div>

            <button type="submit" class="w-100 btn btn-lg btn-primary">Create account</button>

            @if (!string.IsNullOrEmpty(responseMessage))
            {
                <div class="alert alert-info mt-4">
                    <i class="bi bi-info-circle me-2"></i>@responseMessage
                </div>
            }
        </EditForm>

        <p class="ds-auth-footer">
            Already have an account? <a href="login">Sign in</a>
        </p>
    </div>
</div>

@code {
    private UserRegistrationRequest registrationModel = new UserRegistrationRequest();
    private string responseMessage;

    protected override void OnInitialized()
    {
        registrationModel.role = "Teacher";
    }

    private async Task RegisterUser()
    {
        registrationModel.role = "Teacher";

        var httpClient = HttpClientFactory.CreateClient("DiagrammaticClient");
        var response = await httpClient.PostAsJsonAsync("/identity/register", registrationModel);

        if (response.IsSuccessStatusCode)
        {
            var authSuccessResponse = await response.Content.ReadFromJsonAsync<AuthSuccessResponse>();
            responseMessage = "Registration successful!";
            toastService.ShowSuccess(responseMessage);
            NavigationManager.NavigateTo("/login");
        }
        else
        {
            var authFailedResponse = await response.Content.ReadFromJsonAsync<AuthFailedResponse>();
            responseMessage = "Registration failed";
            toastService.ShowError(responseMessage);
        }
    }
}
