@page "/login"
@using Diagrammatic2.Components.Shared.Requests
@using Diagrammatic2.Components.Shared.Responses
@using Diagrammatic_test.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject IHttpClientFactory HttpClientFactory
@inject RefreshService RefreshService
@inject NavigationManager NavigationManager
@inject IToastService toastService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject Blazored.SessionStorage.ISessionStorageService SessionStorage
@attribute [AllowAnonymous]

<PageTitle>Log in · Diagrammatic</PageTitle>

<div class="ds-auth-shell">
    <div class="ds-auth-card">
        <div class="ds-auth-brand">
            <span>Diagrammatic</span>
        </div>

        <h1 class="ds-auth-title">Welcome back</h1>
        <p class="ds-auth-subtitle">Sign in to continue to your workspace.</p>

        <EditForm Model="loginModel" OnValidSubmit="loginUser" FormName="loginForm">
            <DataAnnotationsValidator />

            <div class="form-floating mb-3">
                <InputText id="email"
                           @bind-Value="loginModel.email"
                           class="form-control"
                           autocomplete="username"
                           placeholder="name@example.com"
                           inputmode="email" />
                <label for="email">Email address</label>
                <ValidationMessage For="@(() => loginModel.email)" class="validation-message" />
            </div>

            <div class="form-floating mb-4">
                <InputText id="password"
                           type="password"
                           @bind-Value="loginModel.password"
                           class="form-control"
                           autocomplete="current-password"
                           placeholder="password" />
                <label for="password">Password</label>
                <ValidationMessage For="@(() => loginModel.password)" class="validation-message" />
            </div>

            <button type="submit" class="w-100 btn btn-lg btn-primary">Sign in</button>
        </EditForm>

        <p class="ds-auth-footer">
            Don't have an account?
            <a href="register">Create one</a> ·
            <a href="register-student">I'm a student</a>
        </p>
    </div>
</div>

@code {
    private UserLoginRequest loginModel = new UserLoginRequest();

    private async Task loginUser()
    {
        try
        {
            var httpClient = HttpClientFactory.CreateClient("DiagrammaticClient");
            var response = await httpClient.PostAsJsonAsync("/identity/login", loginModel);

            if (!response.IsSuccessStatusCode)
            {
                toastService.ShowError("Invalid Username or Password");
                return;
            }

            var authSuccessResponse = await response.Content.ReadFromJsonAsync<AuthSuccessResponse>();

            if (authSuccessResponse == null) return;

            await SessionStorage.SetItemAsync("authToken", authSuccessResponse.Token);
            RefreshService.SetTokens(authSuccessResponse.Token, authSuccessResponse.RefreshToken);

            var authProvider = (AuthStateProviderService)AuthenticationStateProvider;
            await authProvider.MarkUserAsAuthenticated(authSuccessResponse.Token);

            await Task.Delay(100);

            var authState = await authProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            var hasStudentRole = user.IsInRole("Student");
            Console.WriteLine($"User: {user.Identity.Name}, IsStudent: {hasStudentRole}");

            if (hasStudentRole)
            {
                NavigationManager.NavigateTo("/diagram-evaluation", forceLoad: true);
            }
            else
            {
                NavigationManager.NavigateTo("/");
            }
        }
        catch (Exception ex)
        {
            toastService.ShowError($"Login failed: {ex.Message}");
        }
    }
}
