@page "/login"
@using Diagrammatic2.Components.Shared.Requests
@using Diagrammatic2.Components.Shared.Responses
@using Diagrammatic_test.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject IHttpClientFactory HttpClientFactory
@inject RefreshService RefreshService
@inject NavigationManager NavigationManager
@inject IToastService toastService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject Blazored.SessionStorage.ISessionStorageService SessionStorage
@attribute [AllowAnonymous]

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 card shadow-sm p-4">
            <EditForm Model="loginModel" OnValidSubmit="loginUser" FormName="loginForm">
                <DataAnnotationsValidator />

                <h2 class="text-center">Log in to your account</h2>
                <p class="text-muted text-center">Enter your credentials to continue</p>
                <hr />

                <div class="form-floating mb-3">
                    <InputText id="email" @bind-Value="loginModel.email" class="form-control" autocomplete="username" placeholder="name@example.com" />
                    <label for="email">Email address</label>
                    <ValidationMessage For="@(() => loginModel.email)" class="text-danger" />
                </div>

                <div class="form-floating mb-3">
                    <InputText id="password" type="password" @bind-Value="loginModel.password" class="form-control" autocomplete="current-password" placeholder="password" />
                    <label for="password">Password</label>
                    <ValidationMessage For="@(() => loginModel.password)" class="text-danger" />
                </div>

                <button type="submit" class="w-100 btn btn-lg btn-primary">Login</button>

                <div class="mt-3 text-center">
                    <a href="register">Don't have an account? Click here to register.</a>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private UserLoginRequest loginModel = new UserLoginRequest();

    private async Task loginUser()
    {
        try
        {
            var httpClient = HttpClientFactory.CreateClient("DiagrammaticClient");
            var response = await httpClient.PostAsJsonAsync("/identity/login", loginModel);

            if (!response.IsSuccessStatusCode)
            {
                toastService.ShowError("Invalid Username or Password");
                return;
            }

            var authSuccessResponse = await response.Content.ReadFromJsonAsync<AuthSuccessResponse>();

            if (authSuccessResponse == null) return;

            // 1. Store tokens locally
            await SessionStorage.SetItemAsync("authToken", authSuccessResponse.Token);
            RefreshService.SetTokens(authSuccessResponse.Token, authSuccessResponse.RefreshToken);

            // 2. Update Blazor authentication state (This triggers the claim parsing)
            var authProvider = (AuthStateProviderService)AuthenticationStateProvider;
            await authProvider.MarkUserAsAuthenticated(authSuccessResponse.Token);

            // 1. Force a tiny delay to ensure the NotifyAuthenticationStateChanged has finished
            await Task.Delay(100);

            // 2. Get the FRESH state directly from the provider
            var authState = await authProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            // DEBUG: This will help you see if the role is actually there
            var hasStudentRole = user.IsInRole("Student");
            Console.WriteLine($"User: {user.Identity.Name}, IsStudent: {hasStudentRole}");

            // 3. Robust Redirect
            if (hasStudentRole)
            {
                NavigationManager.NavigateTo("/diagram-evaluation", forceLoad: true);
            }
            else
            {
                NavigationManager.NavigateTo("/weather");
            }
        }
        catch (Exception ex)
        {
            toastService.ShowError($"Login failed: {ex.Message}");
        }
    }
}
