@page "/login"
@using Diagrammatic2.Components.Shared.Requests
@using Diagrammatic2.Components.Shared.Responses
@using Diagrammatic_test.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject IHttpClientFactory HttpClientFactory
@inject RefreshService RefreshService
@inject NavigationManager NavigationManager
@inject IToastService toastService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject Blazored.SessionStorage.ISessionStorageService SessionStorage
@attribute [AllowAnonymous]

<div class="row">
    <div class="col-md-4">
        <EditForm Model="loginModel" FormName="loginForm">
            <DataAnnotationsValidator />
            <h2>Log in your account</h2>
            <hr />
            <div class="form-floating mb-3">
                <input id="email" @bind="@loginModel.email" class="form-control" autocomplete="username" placeholder="name@example.com" />
                <label for="email">Email</label>
                <ValidationMessage For="@(() => loginModel.email)" class="text-danger" />
            </div>
            <div class="form-floating mb-3">
                <input id="password" type="password" @bind="@loginModel.password" class="form-control" autocomplete="current-password" placeholder="password" />
                <label for="password">Password</label>
                <ValidationMessage For="@(() => loginModel.password)" class="text-danger" />
            </div>
            <button class="w-100 btn btn-lg btn-primary" @onclick="loginUser">Login</button>
            <br />
            <a class="nav-link active" href="register">Don't have an account? Click here</a>
        </EditForm>
    </div>
</div>

@code {
    private UserLoginRequest loginModel = new UserLoginRequest();

    private async Task loginUser()
    {
        try
        {
            var httpClient = HttpClientFactory.CreateClient("DiagrammaticClient");
            var response = await httpClient.PostAsJsonAsync("/identity/login", loginModel);

            if (!response.IsSuccessStatusCode)
            {
                toastService.ShowError("Invalid Username or Password");
                return;
            }

            var authSuccessResponse = await response.Content.ReadFromJsonAsync<AuthSuccessResponse>();

            // Store token locally
            await SessionStorage.SetItemAsync("authToken", authSuccessResponse.Token);
            RefreshService.SetTokens(authSuccessResponse.Token, authSuccessResponse.RefreshToken);

            // Update Blazor authentication state
            await ((AuthStateProviderService)AuthenticationStateProvider)
                .MarkUserAsAuthenticated(authSuccessResponse.Token);

            // Delay slightly to let UI update
            StateHasChanged();

            toastService.ShowSuccess($"Welcome {loginModel.email}!");

            // Redirect to home/dashboard
            NavigationManager.NavigateTo("/weather");
        }
        catch (Exception ex)
        {
            toastService.ShowError($"Login failed: {ex.Message}");
        }
    }
}
