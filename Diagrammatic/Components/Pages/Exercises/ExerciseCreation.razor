@page "/create-exercise"
@using Diagrammatic_test.Components.Pages.ExerciseCollection.Dto
@using Diagrammatic_test.Components.Pages.Exercises.Dto
@using Diagrammatic_test.Components.Pages.Exercises.Dto.Diagram
@using Diagrammatic_test.Components.Pages.Exercises.Dto.Path
@using Diagrammatic_test.Components.Shared.Dto
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using System.Globalization
@using System.Text.Json
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager
@inject IToastService toastService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject Blazored.SessionStorage.ISessionStorageService SessionStorage
@inject IJSRuntime JS
@inject IOptions<ApiOptions> ApiOptions
@inherits LayoutComponentBase
@attribute [StreamRendering]
@attribute [Authorize(Roles = "Teacher")]

<h3>Create Exercise</h3>

<EditForm Model="_exercise" OnValidSubmit="@HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <!-- Name -->
    <div class="form-group">
        <label>Name</label>
        <input class="form-control" @bind="_exercise.Name" />
    </div>

    <!-- Exercise Collection -->
    <div class="form-group">
        <label>Exercise Collection</label>
        <select class="form-control" @bind="_exercise.ExerciseCollectionId">
            <option value="">--- Select Collection ---</option>
            @foreach (var collection in _exerciseCollections)
            {
                <option value="@collection.Id">@collection.Name</option>
            }
        </select>
    </div>

    <!-- Weight -->
    <div class="form-group">
        <label>Weight</label>
        <input type="number" class="form-control" @bind="_exercise.Weight" />
    </div>

    <!-- Time -->
    <div class="form-group">
        <label>Time to Complete (seconds)</label>
        <input type="number" class="form-control" @bind="_exercise.TimeToComplete" />
    </div>

    <!-- Category -->
    <div class="form-group">
        <label>Category</label>
        <select class="form-control" @bind="_exercise.Category">
            <option value="">--- Select ---</option>
            <option value="path">Path</option>
            <option value="diagram">Diagram</option>
        </select>
    </div>

    <!-- Path exercise fields -->
    @if (_exercise.Category == "path")
    {
        <div class="form-group">
            <label>Definition (shown to the student above the diagram)</label>
            <textarea class="form-control"
                      rows="2"
                      placeholder="Optional. e.g. List every path from node 1 to node 9."
                      @bind="_pathDefinitionInput"></textarea>
        </div>

        <div class="form-group">
            <label>Paths</label>
            <textarea class="form-control"
                      rows="3"
                      placeholder="1 2 3;3 2 1;4 5 6"
                      @bind="_pathsInput"></textarea>
        </div>

        <div class="form-group">
            <label>Credits</label>
            <textarea class="form-control"
                      rows="2"
                      placeholder="33.33;33.33;33.33"
                      @bind="_creditsInput"></textarea>
        </div>
    }

    <!-- Diagram exercise fields -->
    @if (_exercise.Category == "diagram")
    {
        <div class="form-group">
            <label>Definition</label>
            <input class="form-control" @bind="_diagramUrl" />
        </div>
    }

    @* Both kinds of exercise are drawn here rather than uploaded as a file. Pressing
       Create captures the canvas through the same postMessage bridge the student's
       answer is captured with (diagramInterop.js here, newdiagram.js in the editor),
       so a solution is serialized by the editor's own save, exactly like the drawings
       it will be compared against.

       Deliberately one shared block rather than one per category: it keeps a single
       iframe in the render tree, so switching the category between Path and Diagram
       does not tear the editor down and lose what has been drawn. *@
    @if (IsDrawnCategory)
    {
        <div class="form-group">
            <label>
                @(_exercise.Category == "path"
                    ? "Diagram (draw what the paths are read from)"
                    : "Diagram (draw the solution)")
            </label>
            <div class="exercise-diagram-frame">
                <iframe id="exerciseDiagramFrame"
                        title="Diagram editor"
                        src="@ApiOptions.Value.DiagramEditorUrl"
                        allow="fullscreen"></iframe>
            </div>
            <small class="form-text text-muted">
                @if (_exercise.Category == "path")
                {
                    <text>
                        Draw the diagram the class reads their paths off. Students see it
                        during the round but cannot change it. It is captured from the canvas
                        when you press Create.
                    </text>
                }
                else
                {
                    <text>
                        Draw the diagram the students' answers are scored against. It is
                        captured from the canvas when you press Create.
                    </text>
                }
            </small>
        </div>
    }

    <br />
    <button type="submit" class="btn btn-primary">Create</button>
</EditForm>

@if (_errorMessage != null)
{
    toastService.ShowError(_errorMessage);
}

@code {
    /* ===========================
     * DTOs
     * ===========================*/
    private ExerciseCreateDto _exercise = new();
    private PathExerciseCreateDto _pathExercise = new();

    private string _diagramUrl = string.Empty;
    private string _pathsInput = string.Empty;
    private string _creditsInput = string.Empty;
    private string _definitionInput = string.Empty;
    private string _pathDefinitionInput = string.Empty;

    private List<ExerciseCollectionDto> _exerciseCollections = new();
    private string? _errorMessage;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (!authState.User.Identity!.IsAuthenticated)
        {
            toastService.ShowError("Unauthorized");
            NavigationManager.NavigateTo("/");
            return;
        }

        await LoadExerciseCollections();
        StateHasChanged();
    }

    private async Task LoadExerciseCollections()
    {
        try
        {
            var token = await SessionStorage.GetItemAsync<string>("authToken");
            var httpClient = HttpClientFactory.CreateClient("DiagrammaticClient");
            httpClient.DefaultRequestHeaders.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

            _exerciseCollections =
                await httpClient.GetAllPagesAsync<ExerciseCollectionDto>("/api/exerciseCollection");
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private async Task HandleValidSubmit()
    {
        try
        {
            if (_exercise.Category != "path" && _exercise.Category != "diagram")
                throw new Exception("Please select a category.");

            var token = await SessionStorage.GetItemAsync<string>("authToken");
            var httpClient = HttpClientFactory.CreateClient("DiagrammaticClient");
            httpClient.DefaultRequestHeaders.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

            // Diagram payload for POST /api/diagram
            var diagram = new DiagramCreateDto
            {
                Name = _exercise.Name,
                Published = false
            };

            if (_exercise.Category == "path")
            {
                // Parse paths. The server scores a path by exact string match against these,
                // so runs of whitespace are collapsed to single spaces here exactly as
                // DiagramEvaluation.razor does to the student's answer — otherwise "1  2 3"
                // typed on one side and "1 2 3" on the other never match.
                var paths = _pathsInput
                    .Split(';', StringSplitOptions.RemoveEmptyEntries)
                    .Select(p => string.Join(" ", p.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries)))
                    .Where(p => p.Length > 0)
                    .ToList();

                // Parse credits
                var credits = _creditsInput
                    .Split(';', StringSplitOptions.RemoveEmptyEntries)
                    .Select(c => double.Parse(c.Trim(), CultureInfo.InvariantCulture))
                    .ToList();

                if (paths.Count != credits.Count)
                    throw new Exception("Number of paths must match number of credits.");

                _pathExercise.Paths = paths
                    .Select((p, i) => new PathDto
                    {
                        Path = p,
                        Credits = credits[i]
                    })
                    .ToList();

                // The diagram the paths are read from. Stored as the editor's own canvas
                // json — positions, shapes and all — because this one is *displayed*
                // rather than scored: the student's viewer loads it back into a locked
                // editor, so it has to be the drawing, not the bare graph the diagram
                // exercises keep. It takes the slot the uploaded .png used to occupy, and
                // Diagram.Url is what both live views read for a path exercise (they tell
                // the two apart by shape: json here, "/DiagramPhotos/..." on older rows).
                diagram.Url = await CaptureDrawnDiagramForPathAsync();

                // A path exercise has no graph json behind it, but Diagrams.Definition is NOT NULL,
                // so it can never be left unset. DiagramEvaluation.razor prints this above the
                // diagram, so it holds the exercise text — empty (not null) when there is none.
                diagram.Definition = _pathDefinitionInput.Trim();
            }
            else
            {
                // Reads the drawing straight off the embedded editor. Done before anything
                // is POSTed, so a canvas that cannot be captured fails the whole create
                // rather than leaving a diagram row behind with no graph in it.
                await CaptureDrawnDiagramAsync();

                diagram.Url = _diagramUrl;
                diagram.Definition = _definitionInput;
            }

            // 1. Create the diagram
            var diagramResponse = await httpClient.PostAsJsonAsync("/api/diagram", diagram);

            if (!diagramResponse.IsSuccessStatusCode)
                throw new Exception(await diagramResponse.Content.ReadAsStringAsync());

            var createdDiagram = Newtonsoft.Json.JsonConvert.DeserializeObject<DiagramDto>(
                await diagramResponse.Content.ReadAsStringAsync())!;

            // 2. Create the exercise linked to the new diagram
            HttpResponseMessage response;

            if (_exercise.Category == "path")
            {
                _pathExercise.Name = _exercise.Name;
                _pathExercise.Category = _exercise.Category;
                _pathExercise.ProblemType = "path";
                _pathExercise.Weight = _exercise.Weight;
                _pathExercise.TimeToComplete = _exercise.TimeToComplete;
                _pathExercise.ExerciseCollectionId = _exercise.ExerciseCollectionId;
                _pathExercise.Published = false;
                _pathExercise.DiagramId = createdDiagram.Id;

                response = await httpClient.PostAsJsonAsync("/api/exercise", _pathExercise);
            }
            else
            {
                _exercise.ProblemType = "diagram";
                _exercise.Published = false;
                _exercise.DiagramId = createdDiagram.Id;

                response = await httpClient.PostAsJsonAsync("/api/exercise", _exercise);
            }

            if (response.IsSuccessStatusCode)
            {
                toastService.ShowSuccess("Exercise created successfully!");
                _exercise = new ExerciseCreateDto();
                _pathExercise = new PathExerciseCreateDto();
                _diagramUrl = string.Empty;
                _pathsInput = string.Empty;
                _creditsInput = string.Empty;
                _definitionInput = string.Empty;
                _pathDefinitionInput = string.Empty;
            }
            else
            {
                throw new Exception(await response.Content.ReadAsStringAsync());
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }


    /* ===========================
     * Canvas capture
     * ===========================*/

    // Both categories are drawn in the same editor; only what is kept differs.
    private bool IsDrawnCategory => _exercise.Category == "path" || _exercise.Category == "diagram";

    // Pulls the teacher's drawing out of the editor iframe through the postMessage
    // bridge — the same call, and therefore the same serialization, the student's
    // answer goes through in DiagramEvaluation.razor. Must run while the diagram
    // fields (and so the iframe) are still on screen.
    private async Task<string> ReadCanvasAsync()
    {
        string? json;
        try
        {
            json = await JS.InvokeAsync<string?>(
                "diagramInterop.getDiagram", "exerciseDiagramFrame", 3000);
        }
        catch
        {
            json = null; // iframe/interop hiccup — reported as a failed capture below
        }

        if (string.IsNullOrWhiteSpace(json))
            throw new Exception("Could not read the diagram from the editor. Reload the page and draw it again.");

        return json!;
    }

    private DiagramDefinitionDto ReadCanvasShape(string canvasJson, out int dangling)
    {
        try
        {
            return ExtractDiagramDefinition(canvasJson, out dangling);
        }
        catch (Exception ex)
        {
            throw new Exception($"Could not read the diagram from the editor: {ex.Message}");
        }
    }

    // A path exercise's diagram is shown, never scored — the student reads their paths
    // off it while it sits locked in a viewer. So the editor's own canvas json is what
    // gets stored, geometry included; the stripped-down graph the solution diagrams keep
    // would load back as an empty canvas.
    private async Task<string> CaptureDrawnDiagramForPathAsync()
    {
        var canvasJson = await ReadCanvasAsync();
        var drawn = ReadCanvasShape(canvasJson, out var dangling);

        if (drawn.Nodes.Count == 0)
            throw new Exception("Draw the diagram the paths are read from before creating the exercise — the canvas is empty.");

        // Nothing here is scored from the drawing, so a loose arrow costs no marks — but
        // it is still a line the class will try to read a path along.
        if (dangling > 0)
            toastService.ShowWarning(
                $"{dangling} arrow(s) aren't attached to a node — the class will see them exactly as drawn.");

        return canvasJson;
    }

    private async Task CaptureDrawnDiagramAsync()
    {
        var canvasJson = await ReadCanvasAsync();
        var definition = ReadCanvasShape(canvasJson, out var dangling);

        if (definition.Nodes.Count == 0)
            throw new Exception("Draw the solution diagram before creating the exercise — the canvas is empty.");

        // An arrow attached at both ends is the only thing that becomes an edge, and the
        // graph the server scores against is built purely from edges — shapes with no
        // arrows between them vanish from it entirely. A key like that can never be
        // matched: it is what made a correct-looking answer come back as 95 rather than
        // 100, so it is refused here instead of being stored.
        var wiredArrows = definition.Connectors.Count - dangling;

        if (wiredArrows == 0)
            throw new Exception(
                "Connect the shapes with arrows before creating the exercise — a solution with no arrows " +
                "has nothing for an answer to match.");

        // A connector missing an endpoint adds no edge either, so the stored solution is
        // not the diagram on screen. The rest of it is still usable, so this only warns.
        if (dangling > 0)
            toastService.ShowWarning(
                $"{dangling} arrow(s) aren't attached to a node and were left out of the solution.");

        _definitionInput = JsonSerializer.Serialize(definition);
    }

    // Identical to DiagramEvaluation.razor's ExtractDiagramDefinitionFromUpload so the
    // answer key and the answers scored against it are normalized the exact same way.
    private DiagramDefinitionDto ExtractDiagramDefinition(string rawJson, out int danglingConnectors)
    {
        danglingConnectors = 0;

        if (rawJson.TrimStart().StartsWith("\""))
        {
            rawJson = JsonSerializer.Deserialize<string>(rawJson)!;
        }

        using var doc = JsonDocument.Parse(rawJson);
        var root = doc.RootElement;

        var nodes = new List<NodeDefinitionDto>();
        var connectors = new List<ConnectorDefinitionDto>();
        var map = new Dictionary<string, NodeDefinitionDto>();

        if (root.TryGetProperty("nodes", out var nodesElement))
        {
            foreach (var n in nodesElement.EnumerateArray())
            {
                var id = n.GetProperty("id").GetString() ?? Guid.NewGuid().ToString();

                string content = "";

                if (n.TryGetProperty("annotations", out var annos))
                {
                    var firstAnno = annos.EnumerateArray().FirstOrDefault();

                    if (firstAnno.ValueKind != JsonValueKind.Undefined &&
                        firstAnno.TryGetProperty("content", out var contentProp))
                    {
                        content = contentProp.GetString() ?? "";
                    }
                }

                var node = new NodeDefinitionDto
                {
                    Id = id,
                    Annotations =
                    {
                        new NodeAnnotationDto
                        {
                            Id = Guid.NewGuid().ToString(),
                            Content = content
                        }
                    }
                };

                nodes.Add(node);
                map[id] = node;
            }
        }

        if (root.TryGetProperty("connectors", out var connElement))
        {
            foreach (var c in connElement.EnumerateArray())
            {
                var id = c.GetProperty("id").GetString() ?? Guid.NewGuid().ToString();

                var sourceId = c.TryGetProperty("sourceID", out var srcProp) ? srcProp.GetString() : null;
                var targetId = c.TryGetProperty("targetID", out var tgtProp) ? tgtProp.GetString() : null;

                var sourceAttached = false;
                var targetAttached = false;

                if (!string.IsNullOrEmpty(sourceId) && map.TryGetValue(sourceId, out var sourceNode))
                {
                    sourceNode.OutEdges.Add(id);
                    sourceAttached = true;
                }

                if (!string.IsNullOrEmpty(targetId) && map.TryGetValue(targetId, out var targetNode))
                {
                    targetNode.InEdges.Add(id);
                    targetAttached = true;
                }

                if (!sourceAttached || !targetAttached)
                    danglingConnectors++;

                connectors.Add(new ConnectorDefinitionDto { Id = id });
            }
        }

        return new DiagramDefinitionDto
        {
            Nodes = nodes,
            Connectors = connectors
        };
    }
}
