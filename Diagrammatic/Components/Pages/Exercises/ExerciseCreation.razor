@page "/create-exercise"
@using Diagrammatic_test.Components.Pages.ExerciseCollection.Dto
@using Diagrammatic_test.Components.Pages.Exercises.Dto
@using Diagrammatic_test.Components.Pages.Exercises.Dto.Diagram
@using Diagrammatic_test.Components.Pages.Exercises.Dto.Path
@using Diagrammatic_test.Components.Shared.Dto
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using System.Globalization
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager
@inject IToastService toastService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject Blazored.SessionStorage.ISessionStorageService SessionStorage
@inherits LayoutComponentBase
@attribute [StreamRendering]
@attribute [Authorize(Roles = "Teacher")]

<h3>Create Exercise</h3>

<EditForm Model="_exercise" OnValidSubmit="@HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <!-- Name -->
    <div class="form-group">
        <label>Name</label>
        <input class="form-control" @bind="_exercise.Name" />
    </div>

    <!-- Category -->
    <div class="form-group">
        <label>Category</label>
        <select class="form-control" @bind="_exercise.Category">
            <option value="">--- Select ---</option>
            <option value="diagram">Diagram</option>
            <option value="path">Path</option>
        </select>
    </div>

    <!-- Diagram selector for diagram exercises -->
    @if (_exercise.Category == "diagram")
    {
        <div class="form-group mt-3">
            <label>Select Diagram</label>
            <InputSelect class="form-control"
                         TValue="Guid?"
                         @bind-Value="_exercise.DiagramId">
                <option value="">--- Select Diagram ---</option>
                @foreach (var diagram in _diagrams)
                {
                    <option value="@diagram.Id">@diagram.Name</option>
                }
            </InputSelect>
        </div>
    }

    <!-- Path exercise UI -->
    @if (_exercise.Category == "path")
    {
        <div class="mt-3">
            <h5 class="mt-3">Paths Definition</h5>

            <label>Exercise Summary</label>
            <input class="form-control" @bind="_pathExercise.Code" />

            <label class="mt-2">Select Diagram</label>
            <InputSelect class="form-control"
                         TValue="Guid?"
                         @bind-Value="_pathExercise.DiagramId">
                <option value="">--- Select Diagram ---</option>
                @foreach (var diagram in _pathDiagrams)
                {
                    <option value="@diagram.Id">@diagram.Name</option>
                }
            </InputSelect>

            <label>Paths</label>
            <textarea class="form-control"
                      rows="3"
                      placeholder="1 2 3;3 2 1;4 5 6"
                      @bind="_pathsInput">
                </textarea>

            <label class="mt-2">Credits</label>
            <textarea class="form-control"
                      rows="2"
                      placeholder="33.33;33.33;33.33"
                      @bind="_creditsInput">
                </textarea>
        </div>
    }

    <!-- Weight -->
    <div class="form-group">
        <label>Weight</label>
        <input type="number" class="form-control" @bind="_exercise.Weight" />
    </div>

    <!-- Time -->
    <div class="form-group">
        <label>Time to Complete (seconds)</label>
        <input type="number" class="form-control" @bind="_exercise.TimeToComplete" />
    </div>

    <!-- Exercise Collection -->
    <div class="form-group">
        <label>Exercise Collection</label>
        <select class="form-control" @bind="_exercise.ExerciseCollectionId">
            <option value="">--- Select Collection ---</option>
            @foreach (var collection in _exerciseCollections)
            {
                <option value="@collection.Id">@collection.Name</option>
            }
        </select>
    </div>

    <br />
    <button type="submit" class="btn btn-primary">Create</button>
</EditForm>

@if (_errorMessage != null)
{
    toastService.ShowError(_errorMessage);
}

@code {
    /* ===========================
     * DTOs
     * ===========================*/
    private ExerciseCreateDto _exercise = new();
    private PathExerciseCreateDto _pathExercise = new();

    private string _pathsInput = string.Empty;
    private string _creditsInput = string.Empty;

    private List<ExerciseCollectionDto> _exerciseCollections = new();
    private string? _errorMessage;

    // TEMP diagrams for diagram exercises
    private readonly List<(Guid Id, string Name)> _diagrams = new()
    {
        (Guid.Parse("67F8A883-ABDC-44AA-B923-2E741B6DA7A7"), "Askisi1"),
        (Guid.Parse("1572881A-88E0-443D-90D6-91F1FC6E8CEC"), "Askisi2")
    };

    // TEMP diagrams for path exercises
    private readonly List<(Guid Id, string Name)> _pathDiagrams = new()
    {
        (Guid.Parse("0A909782-173B-4EFF-B64F-260742FDC430"), "Path Askisi")
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (!authState.User.Identity!.IsAuthenticated)
        {
            toastService.ShowError("Unauthorized");
            NavigationManager.NavigateTo("/");
            return;
        }

        await LoadExerciseCollections();
        StateHasChanged();
    }

    private async Task LoadExerciseCollections()
    {
        try
        {
            var token = await SessionStorage.GetItemAsync<string>("authToken");
            var httpClient = HttpClientFactory.CreateClient("DiagrammaticClient");
            httpClient.DefaultRequestHeaders.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

            var response = await httpClient.GetAsync("/api/exerciseCollection");

            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                _exerciseCollections =
                    Newtonsoft.Json.JsonConvert.DeserializeObject<List<ExerciseCollectionDto>>(json)!;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private async Task HandleValidSubmit()
    {
        try
        {
            var token = await SessionStorage.GetItemAsync<string>("authToken");
            var httpClient = HttpClientFactory.CreateClient("DiagrammaticClient");
            httpClient.DefaultRequestHeaders.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

            HttpResponseMessage response;

            if (_exercise.Category == "path")
            {
                // Ensure diagram is selected
                if (_pathExercise.DiagramId == null)
                    throw new Exception("Please select a diagram for the path exercise.");

                // Parse paths
                var paths = _pathsInput
                    .Split(';', StringSplitOptions.RemoveEmptyEntries)
                    .Select(p => p.Trim())
                    .ToList();

                // Parse credits
                var credits = _creditsInput
                    .Split(';', StringSplitOptions.RemoveEmptyEntries)
                    .Select(c => double.Parse(c.Trim(), CultureInfo.InvariantCulture))
                    .ToList();

                if (paths.Count != credits.Count)
                    throw new Exception("Number of paths must match number of credits.");

                _pathExercise.Paths = paths
                    .Select((p, i) => new PathDto
                    {
                        Path = p,
                        Credits = credits[i]
                    })
                    .ToList();

                // Copy base fields
                _pathExercise.Name = _exercise.Name;
                _pathExercise.Category = "path";
                _pathExercise.ProblemType = "path";
                _pathExercise.Weight = _exercise.Weight;
                _pathExercise.TimeToComplete = _exercise.TimeToComplete;
                _pathExercise.ExerciseCollectionId = _exercise.ExerciseCollectionId;
                _pathExercise.Published = false;

                Console.WriteLine("DiagramId= " + _pathExercise.DiagramId);
                response = await httpClient.PostAsJsonAsync("/api/exercise", _pathExercise);
            }
            else
            {
                _exercise.Category = "diagram";
                _exercise.ProblemType = "diagram";
                _exercise.Published = false;

                response = await httpClient.PostAsJsonAsync("/api/exercise", _exercise);
            }

            if (response.IsSuccessStatusCode)
            {
                toastService.ShowSuccess("Exercise created successfully!");
                _exercise = new ExerciseCreateDto();
                _pathExercise = new PathExerciseCreateDto();
                _pathsInput = string.Empty;
                _creditsInput = string.Empty;
            }
            else
            {
                throw new Exception(await response.Content.ReadAsStringAsync());
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }
}