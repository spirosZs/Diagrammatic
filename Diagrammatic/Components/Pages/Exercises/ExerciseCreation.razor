@page "/create-exercise"
@using Diagrammatic_test.Components.Pages.ExerciseCollection.Dto
@using Diagrammatic_test.Components.Pages.Exercises.Dto
@using Diagrammatic_test.Components.Pages.Exercises.Dto.DiagramDto
@using Diagrammatic_test.Components.Shared.Dto
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager
@inject IToastService toastService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inherits LayoutComponentBase
@attribute [StreamRendering]
@attribute [Authorize]

<h3>Create Exercise</h3>

<EditForm Model="_exerciseCreateDto" OnValidSubmit="HandleValidSubmit" FormName="exerciseCreationForm">
    <ChildContent Context="editFormContext">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <!-- Name -->
        <div class="form-group">
            <label for="name">Name</label>
            <input id="name" class="form-control" @bind="_exerciseCreateDto.Name" />
            <_errorMessage For="@(() => _exerciseCreateDto.Name)" />
        </div>

        <!-- Category -->
        <div class="form-group">
            <label for="category">Category</label>
            <select id="category" class="form-control" @bind="_exerciseCreateDto.Category">
                <option selected disabled>---Select---</option>
                <option value="diagram">Diagram</option>
                <option value="path">Path</option>
            </select>
            <_errorMessage For="@(() => _exerciseCreateDto.Category)" />
        </div>

        <!-- Conditional Diagram Fields -->
        @if (_exerciseCreateDto.Category == "diagram")
        {
            <div class="form-group mt-3 p-3 border rounded">
                <h5>Diagram Details</h5>

                <div class="form-group">
                    <label for="diagramUrl">Diagram URL</label>
                    <input id="diagramUrl" class="form-control"
                           @bind="_exerciseCreateDto.Url" />
                    <_errorMessage For="@(() => _exerciseCreateDto.Url)" />
                </div>

                <div class="form-group">
                    <label for="diagramDefinition">Diagram Definition (JSON)</label>
                    <textarea id="diagramDefinition" class="form-control" rows="4"
                              @bind="_exerciseCreateDto.Definition"></textarea>
                    <_errorMessage For="@(() => _exerciseCreateDto.Definition)" />
                </div>

                <div class="form-group">
                    <label for="code">Exercise Code</label>
                    <textarea id="code" class="form-control" rows="3"
                              @bind="_exerciseCreateDto.Code"></textarea>
                    <_errorMessage For="@(() => _exerciseCreateDto.Code)" />
                </div>
            </div>
        }

        <!-- Weight -->
        <div class="form-group">
            <label for="weight">Weight</label>
            <input type="number" id="weight" class="form-control" @bind="_exerciseCreateDto.Weight" />
            <_errorMessage For="@(() => _exerciseCreateDto.Weight)" />
        </div>

        <!-- Time to Complete -->
        <div class="form-group">
            <label for="timeToComplete">Time to Complete (seconds)</label>
            <input type="number" id="timeToComplete" class="form-control" @bind="_exerciseCreateDto.TimeToComplete" />
            <_errorMessage For="@(() => _exerciseCreateDto.TimeToComplete)" />
        </div>

        <!-- Exercise Collection -->
        <div class="form-group">
            <label for="exerciseCollection">Exercise Collection</label>
            <select id="exerciseCollection" class="form-control" @bind="_exerciseCreateDto.ExerciseCollectionId">
                <option selected disabled>---Select Collection---</option>
                @foreach (var collection in _exerciseCollections)
                {
                    <option value="@collection.Id">@collection.Name</option>
                }
            </select>
            <_errorMessage For="@(() => _exerciseCreateDto.ExerciseCollectionId)" />
        </div>

        <br />
        <button type="submit" class="btn btn-primary">Submit</button>
    </ChildContent>
</EditForm>

<br />
<br />

<a class="nav-link active" href="delete-exercise">
    Do you want to delete an Exercise? Click here.
</a>

@if (_errorMessage != null)
{
    toastService.ShowError(_errorMessage);
}

@code {
    private List<ExerciseCollectionDto> _exerciseCollections = new();
    private DiagramExerciseCreateDto _exerciseCreateDto = new DiagramExerciseCreateDto();

    private string _errorMessage;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            if (!authState.User.Identity.IsAuthenticated)
            {
                toastService.ShowError("You are not authorized to view this page.");
                NavigationManager.NavigateTo("/");
                return;
            }

            await LoadExerciseCollections();
            StateHasChanged();
        }
    }

    private async Task LoadExerciseCollections()
    {
        try
        {
            var token = await LocalStorage.GetItemAsync<string>("authToken");
            var httpClient = HttpClientFactory.CreateClient("DiagrammaticClient");
            httpClient.DefaultRequestHeaders.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

            var response = await httpClient.GetAsync("/api/exerciseCollection");

            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                _exerciseCollections = Newtonsoft.Json.JsonConvert
                    .DeserializeObject<List<ExerciseCollectionDto>>(json);
            }
            else
            {
                _errorMessage = "Failed to load exercise collections.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private async Task HandleValidSubmit()
    {
        var token = await LocalStorage.GetItemAsync<string>("authToken");
        _exerciseCreateDto.published = false;
        _exerciseCreateDto.ProblemType = _exerciseCreateDto.Category == "diagram" ? "0" : "1";

        try
        {
            var httpClient = HttpClientFactory.CreateClient("DiagrammaticClient");
            httpClient.DefaultRequestHeaders.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

            HttpResponseMessage request;

            // ✅ Send proper DTO type based on category
            if (_exerciseCreateDto.Category == "diagram")
            {
                // send full DiagramExerciseCreateDto
                request = await httpClient.PostAsJsonAsync("/api/exercise", _exerciseCreateDto);
            }
            else
            {
                // send plain ExerciseCreateDto
                var baseDto = new ExerciseCreateDto
                {
                    Name = _exerciseCreateDto.Name,
                    Category = _exerciseCreateDto.Category,
                    ProblemType = _exerciseCreateDto.ProblemType,
                    Weight = _exerciseCreateDto.Weight,
                    TimeToComplete = _exerciseCreateDto.TimeToComplete,
                    ExerciseCollectionId = _exerciseCreateDto.ExerciseCollectionId,
                    published = _exerciseCreateDto.published
                };

                request = await httpClient.PostAsJsonAsync("/api/exercise", baseDto);
            }

            if (request.IsSuccessStatusCode)
            {
                toastService.ShowSuccess("Exercise created successfully!");
                _errorMessage = null;
                _exerciseCreateDto = new DiagramExerciseCreateDto(); // reset form
            }
            else
            {
                var errorContent = await request.Content.ReadAsStringAsync();
                throw new HttpRequestException($"Error creating exercise: {request.StatusCode}, {errorContent}");
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }
}
