@page "/create-exercise"
@using Diagrammatic_test.Components.Pages.ExerciseCollection.Dto
@using Diagrammatic_test.Components.Pages.Exercises.Dto
@using Diagrammatic_test.Components.Pages.Exercises.Dto.Diagram
@using Diagrammatic_test.Components.Pages.Exercises.Dto.Path
@using Diagrammatic_test.Components.Shared.Dto
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Hosting
@using System.Globalization
@using System.IO
@using System.Text.Json
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager
@inject IToastService toastService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject Blazored.SessionStorage.ISessionStorageService SessionStorage
@inject IWebHostEnvironment HostEnvironment
@inherits LayoutComponentBase
@attribute [StreamRendering]
@attribute [Authorize(Roles = "Teacher")]

<h3>Create Exercise</h3>

<EditForm Model="_exercise" OnValidSubmit="@HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <!-- Name -->
    <div class="form-group">
        <label>Name</label>
        <input class="form-control" @bind="_exercise.Name" />
    </div>

    <!-- Exercise Collection -->
    <div class="form-group">
        <label>Exercise Collection</label>
        <select class="form-control" @bind="_exercise.ExerciseCollectionId">
            <option value="">--- Select Collection ---</option>
            @foreach (var collection in _exerciseCollections)
            {
                <option value="@collection.Id">@collection.Name</option>
            }
        </select>
    </div>

    <!-- Weight -->
    <div class="form-group">
        <label>Weight</label>
        <input type="number" class="form-control" @bind="_exercise.Weight" />
    </div>

    <!-- Time -->
    <div class="form-group">
        <label>Time to Complete (seconds)</label>
        <input type="number" class="form-control" @bind="_exercise.TimeToComplete" />
    </div>

    <!-- Category -->
    <div class="form-group">
        <label>Category</label>
        <select class="form-control" @bind="_exercise.Category">
            <option value="">--- Select ---</option>
            <option value="path">Path</option>
            <option value="diagram">Diagram</option>
        </select>
    </div>

    <!-- Path exercise fields -->
    @if (_exercise.Category == "path")
    {
        <div class="form-group">
            <label>Diagram image (upload a .png or .jpg)</label>
            <InputFile OnChange="UploadDiagramImage" accept=".png,.jpg,.jpeg" />
            @if (_imageBytes is not null)
            {
                <div class="text-success mt-1">
                    @_imageFileName selected (@FormatSize(_imageBytes.Length)).
                </div>
                <img src="@_imagePreview" alt="Selected diagram" class="mt-2 d-block img-thumbnail"
                     style="max-width:320px" />
            }
        </div>

        <div class="form-group">
            <label>Definition (shown to the student above the image)</label>
            <textarea class="form-control"
                      rows="2"
                      placeholder="Optional. e.g. List every path from node 1 to node 9."
                      @bind="_pathDefinitionInput"></textarea>
        </div>

        <div class="form-group">
            <label>Paths</label>
            <textarea class="form-control"
                      rows="3"
                      placeholder="1 2 3;3 2 1;4 5 6"
                      @bind="_pathsInput"></textarea>
        </div>

        <div class="form-group">
            <label>Credits</label>
            <textarea class="form-control"
                      rows="2"
                      placeholder="33.33;33.33;33.33"
                      @bind="_creditsInput"></textarea>
        </div>
    }

    <!-- Diagram exercise fields -->
    @if (_exercise.Category == "diagram")
    {
        <div class="form-group">
            <label>Diagram (upload the Diagram in .json format)</label>
            <InputFile OnChange="UploadDiagramFile" accept=".json" />
            @if (!string.IsNullOrEmpty(_definitionInput))
            {
                <div class="text-success mt-1">Diagram loaded.</div>
            }
        </div>

        <div class="form-group">
            <label>Definition</label>
            <input class="form-control" @bind="_diagramUrl" />
        </div>
    }

    <br />
    <button type="submit" class="btn btn-primary">Create</button>
</EditForm>

@if (_errorMessage != null)
{
    toastService.ShowError(_errorMessage);
}

@code {
    /* ===========================
     * DTOs
     * ===========================*/
    private ExerciseCreateDto _exercise = new();
    private PathExerciseCreateDto _pathExercise = new();

    private string _diagramUrl = string.Empty;
    private string _pathsInput = string.Empty;
    private string _creditsInput = string.Empty;
    private string _definitionInput = string.Empty;
    private string _pathDefinitionInput = string.Empty;

    private List<ExerciseCollectionDto> _exerciseCollections = new();
    private string? _errorMessage;

    /* ===========================
     * Path exercise image upload
     * ===========================*/

    // Where DiagramEvaluation.razor's <img src="@diagramUrl"> resolves from: this app's own
    // wwwroot, served by UseStaticFiles. The diagram's Url is stored as "/DiagramPhotos/<file>",
    // so the student's browser fetches it straight off the Blazor host.
    private const string DiagramPhotosFolder = "DiagramPhotos";

    private const long MaxImageBytes = 5 * 1024 * 1024;

    private static readonly string[] AllowedImageExtensions = { ".png", ".jpg", ".jpeg" };

    // The picked image is held in memory and only written to wwwroot on submit, so abandoning
    // the form does not leave orphaned files behind.
    private byte[]? _imageBytes;
    private string? _imageFileName;
    private string? _imagePreview;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (!authState.User.Identity!.IsAuthenticated)
        {
            toastService.ShowError("Unauthorized");
            NavigationManager.NavigateTo("/");
            return;
        }

        await LoadExerciseCollections();
        StateHasChanged();
    }

    private async Task LoadExerciseCollections()
    {
        try
        {
            var token = await SessionStorage.GetItemAsync<string>("authToken");
            var httpClient = HttpClientFactory.CreateClient("DiagrammaticClient");
            httpClient.DefaultRequestHeaders.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

            _exerciseCollections =
                await httpClient.GetAllPagesAsync<ExerciseCollectionDto>("/api/exerciseCollection");
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private async Task HandleValidSubmit()
    {
        try
        {
            if (_exercise.Category != "path" && _exercise.Category != "diagram")
                throw new Exception("Please select a category.");

            var token = await SessionStorage.GetItemAsync<string>("authToken");
            var httpClient = HttpClientFactory.CreateClient("DiagrammaticClient");
            httpClient.DefaultRequestHeaders.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

            // Diagram payload for POST /api/diagram
            var diagram = new DiagramCreateDto
            {
                Name = _exercise.Name,
                Published = false
            };

            if (_exercise.Category == "path")
            {
                if (_imageBytes is null)
                    throw new Exception("Please upload a .png or .jpg image for this exercise.");

                // Parse paths. The server scores a path by exact string match against these,
                // so runs of whitespace are collapsed to single spaces here exactly as
                // DiagramEvaluation.razor does to the student's answer — otherwise "1  2 3"
                // typed on one side and "1 2 3" on the other never match.
                var paths = _pathsInput
                    .Split(';', StringSplitOptions.RemoveEmptyEntries)
                    .Select(p => string.Join(" ", p.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries)))
                    .Where(p => p.Length > 0)
                    .ToList();

                // Parse credits
                var credits = _creditsInput
                    .Split(';', StringSplitOptions.RemoveEmptyEntries)
                    .Select(c => double.Parse(c.Trim(), CultureInfo.InvariantCulture))
                    .ToList();

                if (paths.Count != credits.Count)
                    throw new Exception("Number of paths must match number of credits.");

                _pathExercise.Paths = paths
                    .Select((p, i) => new PathDto
                    {
                        Path = p,
                        Credits = credits[i]
                    })
                    .ToList();

                // Everything else about the exercise is valid by now, so commit the image to
                // wwwroot/DiagramPhotos and point the diagram at it. DiagramEvaluation.razor
                // renders exactly this value as the <img> source.
                diagram.Url = await SaveDiagramImageAsync();

                // A path exercise has no graph json behind it, but Diagrams.Definition is NOT NULL,
                // so it can never be left unset. DiagramEvaluation.razor prints this above the
                // image, so it holds the exercise text — empty (not null) when there is none.
                diagram.Definition = _pathDefinitionInput.Trim();
            }
            else
            {
                diagram.Url = _diagramUrl;
                diagram.Definition = _definitionInput;
            }

            // 1. Create the diagram
            var diagramResponse = await httpClient.PostAsJsonAsync("/api/diagram", diagram);

            if (!diagramResponse.IsSuccessStatusCode)
                throw new Exception(await diagramResponse.Content.ReadAsStringAsync());

            var createdDiagram = Newtonsoft.Json.JsonConvert.DeserializeObject<DiagramDto>(
                await diagramResponse.Content.ReadAsStringAsync())!;

            // 2. Create the exercise linked to the new diagram
            HttpResponseMessage response;

            if (_exercise.Category == "path")
            {
                _pathExercise.Name = _exercise.Name;
                _pathExercise.Category = _exercise.Category;
                _pathExercise.ProblemType = "path";
                _pathExercise.Weight = _exercise.Weight;
                _pathExercise.TimeToComplete = _exercise.TimeToComplete;
                _pathExercise.ExerciseCollectionId = _exercise.ExerciseCollectionId;
                _pathExercise.Published = false;
                _pathExercise.DiagramId = createdDiagram.Id;

                response = await httpClient.PostAsJsonAsync("/api/exercise", _pathExercise);
            }
            else
            {
                _exercise.ProblemType = "diagram";
                _exercise.Published = false;
                _exercise.DiagramId = createdDiagram.Id;

                response = await httpClient.PostAsJsonAsync("/api/exercise", _exercise);
            }

            if (response.IsSuccessStatusCode)
            {
                toastService.ShowSuccess("Exercise created successfully!");
                _exercise = new ExerciseCreateDto();
                _pathExercise = new PathExerciseCreateDto();
                _diagramUrl = string.Empty;
                _pathsInput = string.Empty;
                _creditsInput = string.Empty;
                _definitionInput = string.Empty;
                _pathDefinitionInput = string.Empty;
                ClearDiagramImage();
            }
            else
            {
                throw new Exception(await response.Content.ReadAsStringAsync());
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    /* ===========================
     * Path exercise image upload
     * ===========================*/

    // Reads the picked .png/.jpg into memory and shows it back to the teacher. Nothing
    // touches the disk until the exercise is actually created.
    private async Task UploadDiagramImage(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            var extension = Path.GetExtension(file.Name).ToLowerInvariant();

            if (!AllowedImageExtensions.Contains(extension))
                throw new Exception("Only .png, .jpg and .jpeg images are supported.");

            if (file.Size > MaxImageBytes)
                throw new Exception($"The image must be {FormatSize(MaxImageBytes)} or smaller.");

            using var stream = file.OpenReadStream(MaxImageBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);

            _imageBytes = buffer.ToArray();
            _imageFileName = file.Name;

            // Preview only — the stored file is written to wwwroot on submit.
            var contentType = extension == ".png" ? "image/png" : "image/jpeg";
            _imagePreview = $"data:{contentType};base64,{Convert.ToBase64String(_imageBytes)}";

            toastService.ShowSuccess("Image loaded.");
        }
        catch (Exception ex)
        {
            ClearDiagramImage();
            toastService.ShowError($"Failed to read image: {ex.Message}");
        }
    }

    // Writes the buffered image into wwwroot/DiagramPhotos and returns the root-relative url
    // that DiagramEvaluation.razor puts straight into its <img src>.
    private async Task<string> SaveDiagramImageAsync()
    {
        var webRoot = HostEnvironment.WebRootPath
                      ?? Path.Combine(HostEnvironment.ContentRootPath, "wwwroot");

        var folder = Path.Combine(webRoot, DiagramPhotosFolder);
        Directory.CreateDirectory(folder);

        var fileName = BuildImageFileName(_imageFileName!);
        await File.WriteAllBytesAsync(Path.Combine(folder, fileName), _imageBytes!);

        return $"/{DiagramPhotosFolder}/{fileName}";
    }

    // The teacher's file name is only a hint: it is stripped down to letters and digits and
    // given a random suffix, so two uploads called "graph.png" cannot overwrite each other and
    // nothing in the name can escape the DiagramPhotos folder.
    private static string BuildImageFileName(string originalName)
    {
        var extension = Path.GetExtension(originalName).ToLowerInvariant();

        var stem = new string(Path.GetFileNameWithoutExtension(originalName)
            .Select(c => char.IsLetterOrDigit(c) ? c : '-')
            .ToArray()).Trim('-');

        if (stem.Length > 40)
            stem = stem.Substring(0, 40);

        if (string.IsNullOrEmpty(stem))
            stem = "diagram";

        return $"{stem}-{Guid.NewGuid():N}{extension}";
    }

    private void ClearDiagramImage()
    {
        _imageBytes = null;
        _imageFileName = null;
        _imagePreview = null;
    }

    private static string FormatSize(long bytes) =>
        bytes >= 1024 * 1024
            ? $"{bytes / (1024d * 1024d):0.#} MB"
            : $"{Math.Max(1, bytes / 1024)} KB";

    private async Task UploadDiagramFile(InputFileChangeEventArgs e)
    {
        try
        {
            using var reader = new StreamReader(e.File.OpenReadStream(long.MaxValue));
            var inputJson = await reader.ReadToEndAsync();

            // Filter the uploaded diagram exactly the same way DiagramEvaluation.razor
            // does, and store the normalized DiagramDefinitionDto so the evaluation page
            // can consume it directly.
            var definition = ExtractDiagramDefinitionFromUpload(inputJson);
            _definitionInput = JsonSerializer.Serialize(definition);

            toastService.ShowSuccess("Diagram loaded.");
        }
        catch (Exception ex)
        {
            _definitionInput = string.Empty;
            toastService.ShowError($"Failed to read diagram: {ex.Message}");
        }
    }

    // Identical to DiagramEvaluation.razor's ExtractDiagramDefinitionFromUpload so both
    // pages normalize uploaded diagrams the exact same way.
    private DiagramDefinitionDto ExtractDiagramDefinitionFromUpload(string rawJson)
    {
        if (rawJson.TrimStart().StartsWith("\""))
        {
            rawJson = JsonSerializer.Deserialize<string>(rawJson)!;
        }

        using var doc = JsonDocument.Parse(rawJson);
        var root = doc.RootElement;

        var nodes = new List<NodeDefinitionDto>();
        var connectors = new List<ConnectorDefinitionDto>();
        var map = new Dictionary<string, NodeDefinitionDto>();

        if (root.TryGetProperty("nodes", out var nodesElement))
        {
            foreach (var n in nodesElement.EnumerateArray())
            {
                var id = n.GetProperty("id").GetString() ?? Guid.NewGuid().ToString();

                string content = "";

                if (n.TryGetProperty("annotations", out var annos))
                {
                    var firstAnno = annos.EnumerateArray().FirstOrDefault();

                    if (firstAnno.ValueKind != JsonValueKind.Undefined &&
                        firstAnno.TryGetProperty("content", out var contentProp))
                    {
                        content = contentProp.GetString() ?? "";
                    }
                }

                var node = new NodeDefinitionDto
                {
                    Id = id,
                    Annotations =
                    {
                        new NodeAnnotationDto
                        {
                            Id = Guid.NewGuid().ToString(),
                            Content = content
                        }
                    }
                };

                nodes.Add(node);
                map[id] = node;
            }
        }

        if (root.TryGetProperty("connectors", out var connElement))
        {
            foreach (var c in connElement.EnumerateArray())
            {
                var id = c.GetProperty("id").GetString() ?? Guid.NewGuid().ToString();
                var sourceId = c.GetProperty("sourceID").GetString();
                var targetId = c.GetProperty("targetID").GetString();

                if (sourceId != null && targetId != null)
                {
                    if (map.TryGetValue(sourceId, out var sourceNode))
                        sourceNode.OutEdges.Add(id);

                    if (map.TryGetValue(targetId, out var targetNode))
                        targetNode.InEdges.Add(id);
                }

                connectors.Add(new ConnectorDefinitionDto { Id = id });
            }
        }

        return new DiagramDefinitionDto
        {
            Nodes = nodes,
            Connectors = connectors
        };
    }
}
