@page "/start-game"
@using System.Net.Http.Json
@using System.Text.Json
@using Diagrammatic_test.Components.Pages.Exam.Dto
@using Diagrammatic_test.Components.Pages.Game.Dto
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.SignalR.Client
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager
@inject IToastService toastService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject Blazored.SessionStorage.ISessionStorageService SessionStorage
@inherits LayoutComponentBase
@implements IAsyncDisposable
@attribute [StreamRendering]
@attribute [Authorize(Roles = "Teacher")]

<h3>Start Game</h3>

@if (!_started)
{
    @if (!_inLobby)
    {
        <form @onsubmit="OpenLobbyAsync">
            <div class="form-group">
                <label for="examId">Game ID</label>
                <select id="examId" class="form-control" @onchange="OnExamSelected">
                    <option value="">-- Select --</option>
                    @if (_examCollection != null)
                    {
                        @foreach (var collection in _examCollection)
                        {
                            <option>@collection.Name</option>
                        }
                    }
                </select>
            </div>

            <br />
            <button type="submit" class="btn btn-primary" disabled="@(_selectedExamId == Guid.Empty)">Open Lobby</button>
        </form>
    }
    else
    {
        <div class="card mt-3 p-4 text-center">
            <h4 class="mb-3">Lobby — @_selectedExam?.Name</h4>

            <div class="mb-3">
                <div class="text-muted text-uppercase small">Participation code</div>
                <div class="display-4 fw-bold text-primary">@_selectedExam?.ParticipationCode</div>
            </div>

            <div class="mb-4">
                <span class="badge bg-success fs-5">Participants ready: @_participantCount</span>
            </div>

            <p class="text-muted">
                Share the code above with your students. Anyone who enters it will appear in the
                count here. Start the game when everyone is ready.
            </p>

            <div class="d-flex justify-content-center gap-2">
                <button class="btn btn-outline-secondary" @onclick="BackToSelection" disabled="@_starting">Back</button>
                <button class="btn btn-success" @onclick="HandleValidSubmit" disabled="@_starting">
                    @(_starting ? "Starting..." : "Start Game")
                </button>
            </div>
        </div>
    }
}

@if (_gameInfo != null)
{
    <div class="card mt-3 p-3">
        <h5>Game Info</h5>
        <ul>
            <li><strong>Category:</strong> @_gameInfo.Category</li>
            <li><strong>Has Started:</strong> @_gameInfo.HasStarted</li>
            <li><strong>Has Ended:</strong> @_gameInfo.HasEnded</li>
            <li><strong>Date Started:</strong> @_gameInfo.DateStarted</li>
            <li><strong>Date Ended:</strong> @_gameInfo.DateEnded</li>
            <li><strong>Participants:</strong> @_gameInfo.Participants</li>
            <li><strong>Total Exercises:</strong> @_gameInfo.TotalExercises</li>
            <li><strong>Date Time To End:</strong> @_gameInfo.DateTimeToEnd</li>
            <li><strong>Date Time To Next Exercise:</strong> @_gameInfo.DateTimeToNextExercise</li>
        </ul>
    </div>
}

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-danger mt-3">@_errorMessage</div>
}

@code {
    private Guid _selectedExamId = Guid.Empty;
    private ExamDto? _selectedExam;
    private GameInfoDto? _gameInfo;
    private List<ExamDto> _examCollection = new(); // Initialized to avoid null errors
    private string _errorMessage = "";

    // Lobby state
    private bool _inLobby;
    private bool _started;
    private bool _starting;
    private int _participantCount;
    private HubConnection? _hub;

    protected override void OnInitialized()
    {
        // Keep UI objects initialized but don't call JS-dependent methods here
        _examCollection = new List<ExamDto>();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // 1. Check Auth State Safely
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            if (!authState.User.Identity?.IsAuthenticated ?? false)
            {
                toastService.ShowError("You are not authorized to view this page.");
                NavigationManager.NavigateTo("/");
                return;
            }

            // 2. Load Data Safely
            await loadExamCollection();

            // 3. Update UI
            StateHasChanged();
        }
    }

    private async Task loadExamCollection()
    {
        try
        {
            var httpClient = await CreateClientAsync();
            if (httpClient == null) return;

            var response = await httpClient.GetAsync("/api/exam");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                _examCollection = Newtonsoft.Json.JsonConvert.DeserializeObject<List<ExamDto>>(json) ?? new();
            }
            else
            {
                _errorMessage = "Failed to load exams.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private void OnExamSelected(ChangeEventArgs e)
    {
        var selectedName = e.Value?.ToString();

        if (!string.IsNullOrEmpty(selectedName))
        {
            var selectedExam = _examCollection.FirstOrDefault(c => c.Name == selectedName);
            if (selectedExam != null)
            {
                _selectedExam = selectedExam;
                _selectedExamId = selectedExam.Id;
            }
            else
            {
                toastService.ShowError("Selected exam not found.");
            }
        }
        else
        {
            _selectedExam = null;
            _selectedExamId = Guid.Empty;
        }
    }

    // ---------------- LOBBY ----------------
    private async Task OpenLobbyAsync()
    {
        if (_selectedExamId == Guid.Empty || _selectedExam == null) return;

        _errorMessage = "";
        _inLobby = true;

        // Baseline count (students who joined before the lobby was opened), then go live.
        await RefreshParticipantCountAsync();
        await ConnectToHubAsync();
    }

    private async Task BackToSelection()
    {
        await DisconnectHubAsync();
        _inLobby = false;
        _participantCount = 0;
    }

    private async Task RefreshParticipantCountAsync()
    {
        try
        {
            var client = await CreateClientAsync();
            if (client == null) return;

            var info = await client.GetFromJsonAsync<GameInfoDto>($"/api/game/{_selectedExamId}");
            if (info != null)
            {
                _participantCount = info.Participants;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to refresh participants: {ex.Message}";
        }
    }

    // ---------------- SIGNALR ----------------
    private async Task ConnectToHubAsync()
    {
        if (_hub is not null) return;

        // Read the token on the UI thread (JS interop) and capture it; the SignalR
        // negotiation runs off the circuit's JS context.
        var token = await SessionStorage.GetItemAsync<string>("authToken");

        _hub = new HubConnectionBuilder()
            .WithUrl("http://localhost:8083/gameHub", options =>
            {
                options.AccessTokenProvider = () => Task.FromResult<string?>(token);
            })
            .WithAutomaticReconnect()
            .Build();

        // Server broadcasts "Notify"(eventTypeName, jsonParams) to all clients.
        _hub.On<string, string>("Notify", async (eventType, json) =>
        {
            if (TryGetExamId(json, out var examId) && examId != _selectedExamId)
                return; // event for a different game

            if (eventType is "ParticipantEntered" or "ParticipantLeft")
            {
                await InvokeAsync(RefreshParticipantCountAsync);
            }
        });

        // After a dropped connection, re-sync the count.
        _hub.Reconnected += _ => InvokeAsync(RefreshParticipantCountAsync);

        try
        {
            await _hub.StartAsync();
        }
        catch (Exception ex)
        {
            toastService.ShowError($"Live updates unavailable: {ex.Message}");
        }
    }

    private async Task DisconnectHubAsync()
    {
        if (_hub is not null)
        {
            try { await _hub.DisposeAsync(); }
            catch { /* ignore */ }
            _hub = null;
        }
    }

    private static bool TryGetExamId(string json, out Guid examId)
    {
        examId = Guid.Empty;
        if (string.IsNullOrWhiteSpace(json)) return false;

        try
        {
            using var doc = JsonDocument.Parse(json);
            foreach (var prop in doc.RootElement.EnumerateObject())
            {
                if (string.Equals(prop.Name, "examId", StringComparison.OrdinalIgnoreCase))
                    return Guid.TryParse(prop.Value.GetString(), out examId);
            }
        }
        catch
        {
            // ignore malformed payloads
        }

        return false;
    }

    // ---------------- START ----------------
    private async Task HandleValidSubmit()
    {
        if (_selectedExamId == Guid.Empty || _starting) return;

        _starting = true;
        StateHasChanged();

        try
        {
            _errorMessage = "";
            var httpClient = await CreateClientAsync();

            var response = await httpClient.PostAsync($"/api/game/{_selectedExamId}/start", null);

            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                _gameInfo = Newtonsoft.Json.JsonConvert.DeserializeObject<GameInfoDto>(json);

                // Game officially started: leave the lobby and stop listening for joins.
                _started = true;
                _inLobby = false;
                await DisconnectHubAsync();

                toastService.ShowSuccess("Game started successfully!");
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                _errorMessage = $"Error starting game: {response.StatusCode}";
                toastService.ShowError("Failed to start the game.");
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
            toastService.ShowError("An unexpected error occurred.");
        }
        finally
        {
            _starting = false;
            StateHasChanged();
        }
    }

    // ---------------- UTIL ----------------
    private async Task<HttpClient> CreateClientAsync()
    {
        var httpClient = HttpClientFactory.CreateClient("DiagrammaticClient");

        var token = await SessionStorage.GetItemAsync<string>("authToken");
        if (!string.IsNullOrEmpty(token))
        {
            httpClient.DefaultRequestHeaders.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
        }

        return httpClient;
    }

    public async ValueTask DisposeAsync()
    {
        await DisconnectHubAsync();
    }
}
