@page "/start-game"
@using System.Net.Http.Json
@using System.Text.Json
@using Diagrammatic_test.Components.Pages.Exam.Dto
@using Diagrammatic_test.Components.Pages.Game.Dto
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.SignalR.Client
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager
@inject IToastService toastService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject Blazored.SessionStorage.ISessionStorageService SessionStorage
@inject IOptions<ApiOptions> ApiOptions
@inherits LayoutComponentBase
@implements IAsyncDisposable
@attribute [StreamRendering]
@attribute [Authorize(Roles = "Teacher")]

<h3>Start Game</h3>

@if (!_started)
{
    @if (!_inLobby)
    {
        <form @onsubmit="OpenLobbyAsync">
            <div class="form-group">
                <label for="examId">Game ID</label>
                <select id="examId" class="form-control" @onchange="OnExamSelected">
                    <option value="">-- Select --</option>
                    @if (_examCollection != null)
                    {
                        @foreach (var collection in _examCollection)
                        {
                            <option>@collection.Name</option>
                        }
                    }
                </select>
            </div>

            <br />
            <button type="submit" class="btn btn-primary" disabled="@(_selectedExamId == Guid.Empty)">Open Lobby</button>
        </form>
    }
    else
    {
        <div class="card mt-3 p-4 text-center">
            <h4 class="mb-3">Lobby — @_selectedExam?.Name</h4>

            <div class="mb-3">
                <div class="text-muted text-uppercase small">Participation code</div>
                <div class="display-4 fw-bold text-primary">@_selectedExam?.ParticipationCode</div>
            </div>

            <div class="mb-4">
                <span class="badge bg-success fs-5">Participants ready: @_participantCount</span>
            </div>

            <p class="text-muted">
                Share the code above with your students. Anyone who enters it will appear in the
                count here. Start the game when everyone is ready.
            </p>

            <div class="d-flex justify-content-center gap-2">
                <button class="btn btn-outline-secondary" @onclick="BackToSelection" disabled="@_starting">Back</button>
                <button class="btn btn-success" @onclick="HandleValidSubmit" disabled="@_starting">
                    @(_starting ? "Starting..." : "Start Game")
                </button>
            </div>
        </div>
    }
}

@if (_started)
{
    <div class="card mt-3 p-3">
        <h5>Current Round Exercise</h5>
        @if (_currentExercise != null)
        {
            <ul>
                <li><strong>Name:</strong> @_currentExercise.Name</li>
                <li><strong>Category:</strong> @_currentExercise.Category</li>
                <li><strong>Problem Type:</strong> @_currentExercise.ProblemType</li>
                <li><strong>Weight:</strong> @_currentExercise.Weight</li>
                <li><strong>Time To Complete (s):</strong> @_currentExercise.TimeToComplete</li>
            </ul>

            @* The definition used to sit above the student's editor; it lives here now,
               for the teacher to present to the class. It follows the round, because
               LoadCurrentExerciseAsync re-runs on every round-change event.

               The two exercise kinds keep that text in different fields. Diagram exercises
               put it in Diagram.Url (the "Definition" box on the creation form writes
               there) and Diagram.Definition holds the solution graph json. Path exercises
               are the other way round: Definition is the text and Url is the image the
               student is asked to trace, so show the picture here too — the teacher is
               talking the class through it. *@
            @if (_currentExercise.Category == "diagram"
                 && !string.IsNullOrWhiteSpace(_currentExercise.Diagram?.Url))
            {
                <div class="alert alert-info mb-0">
                    <div class="text-uppercase small fw-bold mb-1">Exercise definition</div>
                    <div>@_currentExercise.Diagram.Url</div>
                </div>
            }
            else if (_currentExercise.Category == "path" && _currentExercise.Diagram != null)
            {
                @if (!string.IsNullOrWhiteSpace(_currentExercise.Diagram.Definition))
                {
                    <div class="alert alert-info">
                        <div class="text-uppercase small fw-bold mb-1">Exercise definition</div>
                        <div>@_currentExercise.Diagram.Definition</div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(_currentExercise.Diagram.Url))
                {
                    @* Sized by max-width/max-height with both dimensions left auto, so the
                       browser scales it down whole and the aspect ratio survives. Bootstrap's
                       img-fluid pins width to 100%, and a max-height on top of that clamped
                       the height without shrinking the width — which squashed the diagram's
                       circles into ellipses. *@
                    <img src="@_currentExercise.Diagram.Url"
                         class="border rounded d-block mx-auto"
                         style="max-width:100%; max-height:60vh; width:auto; height:auto; object-fit:contain;"
                         alt="Exercise diagram" />
                }
            }
        }
        else if (!string.IsNullOrEmpty(_exerciseErrorMessage))
        {
            <p class="text-muted mb-0">@_exerciseErrorMessage</p>
        }
        else
        {
            <p class="text-muted mb-0">Loading exercise...</p>
        }
    </div>
}

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-danger mt-3">@_errorMessage</div>
}

@code {
    private Guid _selectedExamId = Guid.Empty;
    private ExamDto? _selectedExam;
    private GameExerciseDto? _currentExercise;
    private string _exerciseErrorMessage = "";
    private List<ExamDto> _examCollection = new(); // Initialized to avoid null errors
    private string _errorMessage = "";

    // Lobby state
    private bool _inLobby;
    private bool _started;
    private bool _starting;
    private int _participantCount;
    private HubConnection? _hub;

    protected override void OnInitialized()
    {
        // Keep UI objects initialized but don't call JS-dependent methods here
        _examCollection = new List<ExamDto>();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // 1. Check Auth State Safely
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            if (!authState.User.Identity?.IsAuthenticated ?? false)
            {
                toastService.ShowError("You are not authorized to view this page.");
                NavigationManager.NavigateTo("/");
                return;
            }

            // 2. Load Data Safely
            await loadExamCollection();

            // 3. Update UI
            StateHasChanged();
        }
    }

    private async Task loadExamCollection()
    {
        try
        {
            var httpClient = await CreateClientAsync();
            if (httpClient == null) return;

            _examCollection = await httpClient.GetAllPagesAsync<ExamDto>("/api/exam");
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private void OnExamSelected(ChangeEventArgs e)
    {
        var selectedName = e.Value?.ToString();

        if (!string.IsNullOrEmpty(selectedName))
        {
            var selectedExam = _examCollection.FirstOrDefault(c => c.Name == selectedName);
            if (selectedExam != null)
            {
                _selectedExam = selectedExam;
                _selectedExamId = selectedExam.Id;
            }
            else
            {
                toastService.ShowError("Selected exam not found.");
            }
        }
        else
        {
            _selectedExam = null;
            _selectedExamId = Guid.Empty;
        }
    }

    // ---------------- LOBBY ----------------
    private async Task OpenLobbyAsync()
    {
        if (_selectedExamId == Guid.Empty || _selectedExam == null) return;

        _errorMessage = "";
        _inLobby = true;

        // Baseline count (students who joined before the lobby was opened), then go live.
        await RefreshParticipantCountAsync();
        await ConnectToHubAsync();
    }

    private async Task BackToSelection()
    {
        await DisconnectHubAsync();
        _inLobby = false;
        _participantCount = 0;
    }

    private async Task RefreshParticipantCountAsync()
    {
        try
        {
            var client = await CreateClientAsync();
            if (client == null) return;

            var info = await client.GetFromJsonAsync<GameInfoDto>($"/api/game/{_selectedExamId}");
            if (info != null)
            {
                _participantCount = info.Participants;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to refresh participants: {ex.Message}";
        }
    }

    // ---------------- CURRENT EXERCISE ----------------
    private async Task LoadCurrentExerciseAsync()
    {
        if (_selectedExamId == Guid.Empty) return;

        try
        {
            var client = await CreateClientAsync();
            if (client == null) return;

            var response = await client.GetAsync($"/api/game/{_selectedExamId}/exercise");

            if (response.StatusCode == System.Net.HttpStatusCode.NoContent)
            {
                _currentExercise = null;
                _exerciseErrorMessage = "No exercise available for the current round.";
            }
            else if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                _currentExercise = Newtonsoft.Json.JsonConvert.DeserializeObject<GameExerciseDto>(json);
                _exerciseErrorMessage = "";
            }
            else
            {
                _currentExercise = null;
                _exerciseErrorMessage = $"Failed to load current exercise: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            _currentExercise = null;
            _exerciseErrorMessage = $"Failed to load current exercise: {ex.Message}";
        }

        StateHasChanged();
    }

    // ---------------- SIGNALR ----------------
    private async Task ConnectToHubAsync()
    {
        if (_hub is not null) return;

        // Read the token on the UI thread (JS interop) and capture it; the SignalR
        // negotiation runs off the circuit's JS context.
        var token = await SessionStorage.GetItemAsync<string>("authToken");

        _hub = new HubConnectionBuilder()
            .WithUrl(ApiOptions.Value.HubUrl, options =>
            {
                options.AccessTokenProvider = () => Task.FromResult<string?>(token);
            })
            .WithAutomaticReconnect()
            .Build();

        // Server broadcasts "Notify"(eventTypeName, jsonParams) to all clients.
        _hub.On<string, string>("Notify", async (eventType, json) =>
        {
            if (TryGetExamId(json, out var examId) && examId != _selectedExamId)
                return; // event for a different game

            switch (eventType)
            {
                case "ParticipantEntered":
                case "ParticipantLeft":
                    await InvokeAsync(RefreshParticipantCountAsync);
                    break;
                case "ExerciseCompleted":
                case "ExerciseSkipped":
                case "ExerciseTimeChanged":
                    await InvokeAsync(LoadCurrentExerciseAsync);
                    break;
            }
        });

        // After a dropped connection, re-sync whatever is currently on screen.
        _hub.Reconnected += _ => InvokeAsync(_started ? LoadCurrentExerciseAsync : RefreshParticipantCountAsync);

        try
        {
            await _hub.StartAsync();
        }
        catch (Exception ex)
        {
            toastService.ShowError($"Live updates unavailable: {ex.Message}");
        }
    }

    private async Task DisconnectHubAsync()
    {
        if (_hub is not null)
        {
            try { await _hub.DisposeAsync(); }
            catch { /* ignore */ }
            _hub = null;
        }
    }

    private static bool TryGetExamId(string json, out Guid examId)
    {
        examId = Guid.Empty;
        if (string.IsNullOrWhiteSpace(json)) return false;

        try
        {
            using var doc = JsonDocument.Parse(json);
            foreach (var prop in doc.RootElement.EnumerateObject())
            {
                if (string.Equals(prop.Name, "examId", StringComparison.OrdinalIgnoreCase))
                    return Guid.TryParse(prop.Value.GetString(), out examId);
            }
        }
        catch
        {
            // ignore malformed payloads
        }

        return false;
    }

    // ---------------- START ----------------
    private async Task HandleValidSubmit()
    {
        if (_selectedExamId == Guid.Empty || _starting) return;

        _starting = true;
        StateHasChanged();

        try
        {
            _errorMessage = "";
            var httpClient = await CreateClientAsync();

            var response = await httpClient.PostAsync($"/api/game/{_selectedExamId}/start", null);

            if (response.IsSuccessStatusCode)
            {
                // Game officially started: leave the lobby, but keep the hub connected so
                // round-change events (ExerciseCompleted/Skipped/TimeChanged) can refresh
                // the current exercise below.
                _started = true;
                _inLobby = false;
                await LoadCurrentExerciseAsync();

                toastService.ShowSuccess("Game started successfully!");
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                _errorMessage = $"Error starting game: {response.StatusCode}";
                toastService.ShowError("Failed to start the game.");
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
            toastService.ShowError("An unexpected error occurred.");
        }
        finally
        {
            _starting = false;
            StateHasChanged();
        }
    }

    // ---------------- UTIL ----------------
    private async Task<HttpClient> CreateClientAsync()
    {
        var httpClient = HttpClientFactory.CreateClient("DiagrammaticClient");

        var token = await SessionStorage.GetItemAsync<string>("authToken");
        if (!string.IsNullOrEmpty(token))
        {
            httpClient.DefaultRequestHeaders.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
        }

        return httpClient;
    }

    public async ValueTask DisposeAsync()
    {
        await DisconnectHubAsync();
    }
}
