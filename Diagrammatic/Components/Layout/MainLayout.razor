@using Diagrammatic_test.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject IToastService toastService
@inject RefreshService RefreshService
@inherits LayoutComponentBase




<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
         <CascadingAuthenticationState>
            <AuthorizeView>
                <NotAuthorized>
                    <div class="top-row px-4">
                        <a class="nav-link active" aria-current="page" href="login">Log in</a>
                        <a class="nav-link active" aria-current="page" href="register">Sign Up</a>
                    </div>
                </NotAuthorized>
            </AuthorizeView>
        </CascadingAuthenticationState>

        <CascadingAuthenticationState>
            <AuthorizeView>
                <Authorized>
                    <div class="top-row px-4">
                        <Dropdown Color="DropdownColor.Secondary" Split="true">
                            <DropdownActionButton>Secondary</DropdownActionButton>
                            <DropdownToggleButton />
                            <DropdownMenu>
                                <DropdownItem To="#" Type="DropdownItemType.Link">Action</DropdownItem>
                                <DropdownItem To="#" Type="DropdownItemType.Link">Another action</DropdownItem>
                                <DropdownItem To="#" Type="DropdownItemType.Link">Something else here</DropdownItem>
                            </DropdownMenu>
                        </Dropdown>
                        <a class="nav-link" aria-current="page" href="login" @onclick="Logout">Log out</a>
                    </div>
                </Authorized>
            </AuthorizeView>
        </CascadingAuthenticationState>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<BlazoredToasts />
<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {

    private bool isActive = false;

    private async Task Logout()
    {
        ((AuthStateProviderService)AuthenticationStateProvider).SetUserLoggedOut();
        RefreshService.ClearTokens();
        toastService.ShowSuccess("You have successfully logged out.");
        NavigationManager.NavigateTo("/login");
        StateHasChanged(); // Update the UI
    }

    private void OnSelected(string selection)
    {
        Console.WriteLine(selection);
    }
    

    private void Show()
    {
        isActive = true;
    }

    private void Hide()
    {
        isActive = false;
    }
}
}