@using Microsoft.AspNetCore.Components.Authorization
<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Diagrammatic_test</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="counter">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Counter
            </NavLink>
        </div>
        <CascadingAuthenticationState>
            <AuthorizeView>
                <Authorized>


                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="weather">
                            <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Weather
                        </NavLink>
                    </div>

                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="create-exercise">
                            <span class="bi bi-file-earmark-text" aria-hidden="true"></span> Exercises
                        </NavLink>
                    </div>

                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="add-exercise-to-collection">
                            <span class="bi bi-file-earmark-text" aria-hidden="true"></span> Exercise to Collection
                        </NavLink>
                    </div>

                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="create-exerciseCollection">
                            <span class="bi bi-folder" aria-hidden="true"></span> Exercise Collection
                        </NavLink>
                    </div>

                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="create-exam">
                            <span class="bi bi-folder" aria-hidden="true"></span> Exam Creation
                        </NavLink>
                    </div> 

                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="start-game">
                            <span class="bi bi-folder" aria-hidden="true"></span> Start Game
                        </NavLink>
                    </div> 

                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="diagram-evaluation">
                            <span class="bi bi-folder" aria-hidden="true"></span> Diagram Evaluation
                        </NavLink>
                    </div>

                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="delete-exercise">
                            <span class="bi bi-folder" aria-hidden="true"></span> Delete
                        </NavLink>
                    </div>

                </Authorized>
            </AuthorizeView>
        </CascadingAuthenticationState>

    </nav>
</div>

