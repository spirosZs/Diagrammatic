@page "/login"
@using Diagrammatic2.Components.Shared.Requests
@using Diagrammatic2.Components.Shared.Responses
@using Diagrammatic_test.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject IHttpClientFactory HttpClientFactory
@inject RefreshService RefreshService
@inject NavigationManager NavigationManager
@inject IToastService toastService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@attribute [AllowAnonymous]


<div class="row">
    <div class="col-md-4">
        <EditForm Model="loginModel" FormName="loginForm">
            <DataAnnotationsValidator />
            <h2>Log in your account.</h2>
            <hr />
            <div class="form-floating mb-3">
                <input id="email" @bind="@loginModel.email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <label for="email">Email</label>
                <ValidationMessage For="@(() => loginModel.email)" class="text-danger" />
            </div>
            <div class="form-floating mb-3">
                <input id="password" type="password" @bind="@loginModel.password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
                <label for="password">Password</label>
                <ValidationMessage For="@(() => loginModel.password)" class="text-danger" />
            </div>
            <br />
            <button class="w-100 btn btn-lg btn-primary" @onclick="@loginUser">login</button>
            <br />
            <a class="nav-link active" aria-current="page" href="register">Don't have an account?Click here</a>


            
        </EditForm>
    </div>
</div>

@code {
    private UserLoginRequest loginModel = new UserLoginRequest();


    private async Task loginUser()
    {
        // Debugging statements to check model values before sending the request
        // Console.WriteLine($"Email: {loginModel.email}");
        //Console.WriteLine($"Password: {loginModel.password}");

        var httpClient = HttpClientFactory.CreateClient("DiagrammaticClient");
        var response = await httpClient.PostAsJsonAsync("/identity/login", loginModel);
        string responseMessage="";

        if (response.IsSuccessStatusCode)
        {
            var authSuccessResponse = await response.Content.ReadFromJsonAsync<AuthSuccessResponse>();
            responseMessage = $"Successful Login!";
            //responseMessage = $"Successful Login! Token: {authSuccessResponse.Token}";

            // Set the tokens for the Refresh services
            RefreshService.SetTokens(authSuccessResponse.Token, authSuccessResponse.RefreshToken);
            // Set the authentication state
            await StoreToken(authSuccessResponse.Token);
            ((AuthStateProviderService)AuthenticationStateProvider).SetUserAuthenticated(loginModel.email);
            //show success notification
            toastService.ShowSuccess("Welcome " + loginModel.email + "!");
            // Navigate to home page
            NavigationManager.NavigateTo("/weather");

        }
        else
        {
            var authFailedResponse = await response.Content.ReadFromJsonAsync<AuthFailedResponse>();
            responseMessage = "Invalid Username or Password";
            // Show an error toast notification
            toastService.ShowError(responseMessage);
            //responseMessage = "Failed Login: " + string.Join(", ", authFailedResponse.Errors);

            
        }
    }


    //store token after login so that user can create exercises etc. and do things that require user authentication
    private async Task StoreToken(string token)
    {
        await LocalStorage.SetItemAsync("authToken", token);
    }
}
